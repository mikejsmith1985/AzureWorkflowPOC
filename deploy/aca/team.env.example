# team.env.example — NAMES ONLY of the environment variables the demo seeds into its back-office
# connectors on each cold start. These bind to ConnectorSeedOptions via the ASP.NET Core
# "Section__Key" convention (DoubleUnderscore => nested config).
#
# Usage: copy to `team.env` (gitignored) and populate the values FROM THE FORGE VAULT — never by
# hand, never committed (Constitution Article IX). `seed-secrets.ps1` loads them into the deploy
# shell; `deploy.ps1` pushes them to the container app as masked ACA secrets.
#
# The LLM API key is intentionally ABSENT: each visitor supplies their own key in the app (FR-004).

# ── ServiceNow (ticketing intake) ──────────────────────────────────────────────
ConnectorSeed__ServiceNow__InstanceUrl=
ConnectorSeed__ServiceNow__Username=
ConnectorSeed__ServiceNow__Password=

# ── Azure DevOps (work-item tracking) ──────────────────────────────────────────
ConnectorSeed__AzureDevOps__OrganizationUrl=
ConnectorSeed__AzureDevOps__ProjectName=
ConnectorSeed__AzureDevOps__PersonalAccessToken=

# ── Messaging (Teams/Slack/Discord) — supply a webhook URL OR an MCP server endpoint ───
ConnectorSeed__Messaging__Platform=
ConnectorSeed__Messaging__WebhookUrl=
ConnectorSeed__Messaging__McpServerUrl=
ConnectorSeed__Messaging__McpToolName=
ConnectorSeed__Messaging__McpArgumentTemplate=
ConnectorSeed__Messaging__McpAuthToken=
ConnectorSeed__Messaging__Target=
