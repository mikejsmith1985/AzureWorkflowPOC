<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.77.0" />
    <!-- spec-019: Microsoft Agent Framework modernization. The provider-neutral model layer is
         Microsoft.Extensions.AI (IChatClient); Claude is reached via the official Anthropic SDK's
         .AsIChatClient() (GA — deliberately NOT the prerelease Microsoft.Agents.AI.Anthropic). SK stays
         until the atomic cutover (spec-019 D5/D6). -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <!-- spec-019 T043 (BYO-AI): the alternative OpenAI-compatible provider (GA, works with Azure OpenAI,
         OpenAI, and any OpenAI-compatible endpoint). -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="Anthropic" Version="12.35.1" />
    <!-- IHttpClientFactory lives in Microsoft.Extensions.Http, included transitively by web projects
         but must be explicit here since DBAIAzure.Connectors uses Microsoft.NET.Sdk (not Web).
         ILogger<T> is satisfied by the version SK already pulls transitively (no pin needed). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <!-- Official MCP C# SDK (client only) — the Messaging connector is an MCP client over HTTP/SSE.
         Using the SDK satisfies the Framework-First gate (Article VII) vs. hand-rolling JSON-RPC. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.0" />
    <!-- Official Docker Engine API client — the repo-app executor builds/runs a target repo's app
         in throwaway containers (feature 013). Satisfies the Framework-First gate (Article VII)
         vs. shelling out to the docker CLI and parsing text. -->
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBAIAzure.Core\DBAIAzure.Core.csproj" />
  </ItemGroup>
</Project>
