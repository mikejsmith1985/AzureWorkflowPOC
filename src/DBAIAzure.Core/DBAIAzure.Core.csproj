<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- DiffPlex: MIT-licensed line-level diff engine used by WorkflowCodeDiffService -->
    <PackageReference Include="DiffPlex" Version="1.7.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default telemetry field config baked into the assembly for zero-deploy defaults (T002). -->
    <EmbeddedResource Include="Resources/default-telemetry-config.json" />
  </ItemGroup>
</Project>
