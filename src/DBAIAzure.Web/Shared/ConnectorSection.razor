@* One connector's configuration section: fields, Test button, status display, Save (T023-T029, T034, T037). *@
@using System.Text.Json
@inject IConnectorConfigRepository ConfigRepo
@inject IConnectorHealthChecker HealthChecker

<div class="border border-gray-700 rounded-lg p-4 mb-3">

    @* ── Header row: connector title + last-saved timestamp (T034) ─── *@
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-gray-200">@ConnectorLabel</h3>
        @if (Config?.IsConfigured == true && Config.LastUpdatedAt > DateTimeOffset.MinValue)
        {
            <span class="text-[11px] text-gray-500">
                Last saved: @Config.LastUpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
            </span>
        }
    </div>

    @* ── Non-secret fields (connector-specific) ─────────────────────── *@
    @if (ConnectorType == ConnectorType.ServiceNow)
    {
        <div class="mb-2">
            <label class="block text-xs text-gray-400 mb-1">Instance URL</label>
            <input type="text" placeholder="https://company.service-now.com"
                   @bind="_field1" @oninput="OnNonSecretInput"
                   class="@InputClass(_showValidation && string.IsNullOrWhiteSpace(_field1))" />
            @if (_showValidation && string.IsNullOrWhiteSpace(_field1))
            { <p class="text-xs text-red-400 mt-0.5">Instance URL is required.</p> }
        </div>
        <div class="mb-2">
            <label class="block text-xs text-gray-400 mb-1">Username</label>
            <input type="text" placeholder="service-account"
                   @bind="_field2" @oninput="OnNonSecretInput"
                   class="@InputClass(_showValidation && string.IsNullOrWhiteSpace(_field2))" />
            @if (_showValidation && string.IsNullOrWhiteSpace(_field2))
            { <p class="text-xs text-red-400 mt-0.5">Username is required.</p> }
        </div>
    }

    @if (ConnectorType == ConnectorType.AzureDevOps)
    {
        <div class="mb-2">
            <label class="block text-xs text-gray-400 mb-1">Organisation URL</label>
            <input type="text" placeholder="https://dev.azure.com/myorg"
                   @bind="_field1" @oninput="OnNonSecretInput"
                   class="@InputClass(_showValidation && string.IsNullOrWhiteSpace(_field1))" />
            @if (_showValidation && string.IsNullOrWhiteSpace(_field1))
            { <p class="text-xs text-red-400 mt-0.5">Organisation URL is required.</p> }
        </div>
        <div class="mb-2">
            <label class="block text-xs text-gray-400 mb-1">Project Name</label>
            <input type="text" placeholder="MyProject"
                   @bind="_field2" @oninput="OnNonSecretInput"
                   class="@InputClass(_showValidation && string.IsNullOrWhiteSpace(_field2))" />
            @if (_showValidation && string.IsNullOrWhiteSpace(_field2))
            { <p class="text-xs text-red-400 mt-0.5">Project name is required.</p> }
        </div>
    }

    @if (ConnectorType == ConnectorType.LLM)
    {
        <div class="mb-2">
            <label class="block text-xs text-gray-400 mb-1">Provider Endpoint</label>
            <input type="text" placeholder="https://api.anthropic.com"
                   @bind="_field1" @oninput="OnNonSecretInput"
                   class="@InputClass(_showValidation && string.IsNullOrWhiteSpace(_field1))" />
            @if (_showValidation && string.IsNullOrWhiteSpace(_field1))
            { <p class="text-xs text-red-400 mt-0.5">Provider endpoint is required.</p> }
        </div>
        <div class="mb-2">
            <label class="block text-xs text-gray-400 mb-1">Model Name</label>
            <input type="text" placeholder="claude-sonnet-4-6"
                   @bind="_field2" @oninput="OnNonSecretInput"
                   class="@InputClass(_showValidation && string.IsNullOrWhiteSpace(_field2))" />
            @if (_showValidation && string.IsNullOrWhiteSpace(_field2))
            { <p class="text-xs text-red-400 mt-0.5">Model name is required.</p> }
        </div>
    }

    @* ── Secret field (masked password; Teams uses WebhookUrl as its only field) ─ *@
    <div class="mb-3">
        <label class="block text-xs text-gray-400 mb-1">@SecretFieldLabel</label>
        <input type="password"
               placeholder="@(_hasExistingSecret && !_secretChanged ? "••••••••  (unchanged)" : "")"
               @oninput="OnSecretInput"
               class="@InputClass(_showValidation && IsSecretRequiredAndMissing)" />
        @if (_showValidation && IsSecretRequiredAndMissing)
        { <p class="text-xs text-red-400 mt-0.5">@SecretFieldLabel is required.</p> }
    </div>

    @* ── Test result banner ──────────────────────────────────────────── *@
    @if (_testResult is not null)
    {
        <div class="mb-3 px-3 py-2 rounded text-xs @(_testResult.IsSuccess ? "bg-emerald-950 text-emerald-300" : "bg-red-950 text-red-300")">
            @(_testResult.IsSuccess ? "✓ " : "✗ ")@_testResult.Message
        </div>
    }

    @* ── Action buttons ──────────────────────────────────────────────── *@
    <div class="flex gap-2">
        <button @onclick="TestConnectionAsync" disabled="@_isTesting"
                class="px-3 py-1.5 bg-gray-700 hover:bg-gray-600 disabled:opacity-40
                       text-gray-200 text-xs rounded transition-colors">
            @(_isTesting ? "Testing…" : "Test Connection")
        </button>
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    /// <summary>Current persisted configuration for this connector; null when not yet configured.</summary>
    [Parameter] public ConnectorConfig? Config { get; set; }

    /// <summary>Which connector this section configures.</summary>
    [Parameter, EditorRequired] public ConnectorType ConnectorType { get; set; }

    /// <summary>Fired after a successful save so the parent modal can refresh status badges.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    // ── Component-local field state ──────────────────────────────────────
    private string _field1 = "";
    private string _field2 = "";
    private string _secretRawValue = "";
    private bool _secretChanged;
    private bool _hasExistingSecret;
    private bool _isTesting;
    private bool _showValidation;
    private ConnectorTestResult? _testResult;

    private bool IsSecretRequiredAndMissing =>
        !_hasExistingSecret && string.IsNullOrWhiteSpace(_secretRawValue);

    private string ConnectorLabel => ConnectorType switch
    {
        ConnectorType.ServiceNow  => "ServiceNow",
        ConnectorType.AzureDevOps => "Azure DevOps",
        ConnectorType.LLM         => "LLM (Anthropic)",
        ConnectorType.Teams       => "Microsoft Teams",
        _                         => ConnectorType.ToString(),
    };

    private string SecretFieldLabel => ConnectorType switch
    {
        ConnectorType.ServiceNow  => "Password",
        ConnectorType.AzureDevOps => "Personal Access Token",
        ConnectorType.LLM         => "API Key",
        ConnectorType.Teams       => "Webhook URL",
        _                         => "Secret",
    };

    // ── Lifecycle ────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _hasExistingSecret = Config?.HasSecrets ?? false;

        if (Config?.NonSecretConfig is not { } json)
            return;

        switch (ConnectorType)
        {
            case ConnectorType.ServiceNow:
                var snCfg = JsonSerializer.Deserialize<ServiceNowNonSecret>(json, JsonOptions);
                _field1 = snCfg?.InstanceUrl ?? "";
                _field2 = snCfg?.Username ?? "";
                break;

            case ConnectorType.AzureDevOps:
                var adoCfg = JsonSerializer.Deserialize<AdoNonSecret>(json, JsonOptions);
                _field1 = adoCfg?.OrganizationUrl ?? "";
                _field2 = adoCfg?.ProjectName ?? "";
                break;

            case ConnectorType.LLM:
                var llmCfg = JsonSerializer.Deserialize<LlmNonSecret>(json, JsonOptions);
                _field1 = llmCfg?.ProviderEndpoint ?? "";
                _field2 = llmCfg?.ModelName ?? "";
                break;

            case ConnectorType.Teams:
                // Teams has no non-secret config; only the webhook URL secret.
                break;
        }
    }

    // ── Field-change handlers ────────────────────────────────────────────

    private void OnNonSecretInput(ChangeEventArgs _) => ResetTestResult();

    private void OnSecretInput(ChangeEventArgs args)
    {
        _secretRawValue = args.Value?.ToString() ?? "";
        _secretChanged  = !string.IsNullOrEmpty(_secretRawValue);
        ResetTestResult();
    }

    private void ResetTestResult() => _testResult = null;

    // ── Test connection ──────────────────────────────────────────────────

    private async Task TestConnectionAsync()
    {
        _isTesting = true;
        try
        {
            _testResult = await HealthChecker.TestAsync(ConnectorType);
        }
        finally
        {
            _isTesting = false;
        }
    }

    // ── Save (called by modal's Save All button via @ref) ────────────────

    /// <summary>
    /// Validates then persists this connector's settings. Returns false when validation fails
    /// so the modal can abort the Save All batch and report to the user.
    /// </summary>
    public async Task<bool> TrySaveAsync()
    {
        _showValidation = true;

        if (!AreRequiredFieldsValid())
            return false;

        var nonSecretJson    = BuildNonSecretJson();
        var plaintextSecrets = _secretChanged ? BuildSecretJson() : null;

        await ConfigRepo.SaveAsync(ConnectorType, nonSecretJson, plaintextSecrets);

        _showValidation  = false;
        _secretChanged   = false;
        _hasExistingSecret = true;
        _testResult      = null;
        await OnSaved.InvokeAsync();
        return true;
    }

    // ── Validation ───────────────────────────────────────────────────────

    private bool AreRequiredFieldsValid()
    {
        return ConnectorType switch
        {
            ConnectorType.ServiceNow  =>
                !string.IsNullOrWhiteSpace(_field1) &&
                !string.IsNullOrWhiteSpace(_field2) &&
                (_hasExistingSecret || !string.IsNullOrWhiteSpace(_secretRawValue)),

            ConnectorType.AzureDevOps =>
                !string.IsNullOrWhiteSpace(_field1) &&
                !string.IsNullOrWhiteSpace(_field2) &&
                (_hasExistingSecret || !string.IsNullOrWhiteSpace(_secretRawValue)),

            ConnectorType.LLM =>
                !string.IsNullOrWhiteSpace(_field1) &&
                !string.IsNullOrWhiteSpace(_field2) &&
                (_hasExistingSecret || !string.IsNullOrWhiteSpace(_secretRawValue)),

            ConnectorType.Teams =>
                _hasExistingSecret || !string.IsNullOrWhiteSpace(_secretRawValue),

            _ => true,
        };
    }

    // ── JSON builders ────────────────────────────────────────────────────

    private string? BuildNonSecretJson() => ConnectorType switch
    {
        ConnectorType.ServiceNow  =>
            JsonSerializer.Serialize(new ServiceNowNonSecret(_field1.Trim(), _field2.Trim()), JsonOptions),

        ConnectorType.AzureDevOps =>
            JsonSerializer.Serialize(new AdoNonSecret(_field1.Trim(), _field2.Trim()), JsonOptions),

        ConnectorType.LLM =>
            JsonSerializer.Serialize(new LlmNonSecret(_field1.Trim(), _field2.Trim()), JsonOptions),

        ConnectorType.Teams => null,
        _ => null,
    };

    private string? BuildSecretJson() => ConnectorType switch
    {
        ConnectorType.ServiceNow  =>
            JsonSerializer.Serialize(new { password = _secretRawValue.Trim() }, JsonOptions),

        ConnectorType.AzureDevOps =>
            JsonSerializer.Serialize(new { personalAccessToken = _secretRawValue.Trim() }, JsonOptions),

        ConnectorType.LLM =>
            JsonSerializer.Serialize(new { apiKey = _secretRawValue.Trim() }, JsonOptions),

        ConnectorType.Teams =>
            JsonSerializer.Serialize(new { webhookUrl = _secretRawValue.Trim() }, JsonOptions),

        _ => null,
    };

    // ── CSS helper ───────────────────────────────────────────────────────

    private static string InputClass(bool isError) =>
        "w-full bg-gray-900 border rounded px-3 py-2 text-sm text-gray-100 placeholder-gray-600 " +
        "focus:outline-none text-xs " +
        (isError ? "border-red-500 focus:border-red-400" : "border-gray-700 focus:border-cyan-500");

    // ── Private deserialization records ──────────────────────────────────
    // These mirror the connector config records in DBAIAzure.Core.Models but are inline here to
    // keep the Blazor component free of a compile-time reference to the typed records in Core
    // (the JSON was serialized from those types; the keys are the same camelCase names).

    private sealed record ServiceNowNonSecret(string? InstanceUrl, string? Username);
    private sealed record AdoNonSecret(string? OrganizationUrl, string? ProjectName);
    private sealed record LlmNonSecret(string? ProviderEndpoint, string? ModelName);
}
