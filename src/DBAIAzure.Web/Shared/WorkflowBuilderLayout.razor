@* Full-bleed variant of the Admin Console shell for the Workflow Builder. It shows the same sidebar,
   top bar, and right-hand Assistant rail as the rest of the console (so the shell is consistent —
   C-SHELL-6), but the content region is unpadded and overflow-hidden so the palette + canvas fill the
   viewport. The Builder feeds its existing code-assistant chat into the shared Assistant rail through
   a Blazor section seam (US4 / C-AP-4). *@
@inherits LayoutComponentBase
@inject IUiPreferenceService UiPreference
@using DBAIAzure.Web.Services
@using DBAIAzure.Web.Shared
@using DBAIAzure.Web.Shared.Shell

<div class="flex min-h-screen bg-app text-fg">
    <aside class="w-14 lg:w-60 shrink-0 border-r border-line bg-raised" data-testid="app-sidebar">
        <SidebarNav />
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-14 shrink-0 border-b border-line bg-raised flex items-center px-4" data-testid="app-topbar">
            <TopBar />
        </header>

        @* Automation sub-tabs (Workflow Builder | Workflow Gallery) so the Builder can switch views. *@
        <SectionTabs />

        <main class="flex-1 overflow-hidden">
            @Body
        </main>
    </div>

    @* Shared Assistant rail — on the Builder route it hosts the code-assistant chat via SectionOutlet. *@
    <AssistantPanel />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // localStorage is only reachable after the first interactive render; restore the saved
        // text size + Assistant rail open/closed choice so the Builder matches the rest of the shell.
        await UiPreference.InitialiseAsync();
        StateHasChanged();
    }
}
