@* Full-bleed variant of the Admin Console shell for the Workflow Builder. It shows the same sidebar
   and top bar as the rest of the console (so the shell is consistent — C-SHELL-6), but the content
   region is unpadded and overflow-hidden so the palette + canvas fill the viewport. The Builder keeps
   its own embedded chat panel as its assistant until US4 unifies it into the shell-level rail. *@
@inherits LayoutComponentBase
@using DBAIAzure.Web.Shared.Shell

<div class="flex min-h-screen bg-app text-fg">
    <aside class="w-14 lg:w-60 shrink-0 border-r border-line bg-raised" data-testid="app-sidebar">
        <SidebarNav />
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-14 shrink-0 border-b border-line bg-raised flex items-center px-4" data-testid="app-topbar">
            <TopBar />
        </header>

        <main class="flex-1 overflow-hidden">
            @Body
        </main>
    </div>
</div>
