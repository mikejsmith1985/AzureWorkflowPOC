@* Status chip for one connector — shows configured/untested/pass/fail state (T032, US3). *@

<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium @BadgeClass">
    <span>@BadgeLabel</span>
    <span class="font-normal text-gray-400 text-[10px]">@ConnectorLabel</span>
</span>

@code {
    /// <summary>Connector config snapshot loaded from the repository; null means no row in DB yet.</summary>
    [Parameter] public ConnectorConfig? Config { get; set; }

    /// <summary>Which connector this badge represents — used as the label suffix.</summary>
    [Parameter, EditorRequired] public ConnectorType ConnectorType { get; set; }

    private string ConnectorLabel => ConnectorType switch
    {
        ConnectorType.ServiceNow  => "SNow",
        ConnectorType.AzureDevOps => "ADO",
        ConnectorType.LLM         => "LLM",
        ConnectorType.Teams       => "Teams",
        _                         => ConnectorType.ToString(),
    };

    internal string BadgeLabel
    {
        get
        {
            if (Config is null || !Config.IsConfigured)
                return "Not configured";

            if (Config.LastTestResult is null)
                return "Untested";

            if (Config.LastTestResult.IsSuccess)
                return $"Pass · {Config.LastTestResult.TestedAt.ToLocalTime():HH:mm}";

            return $"Fail · {Config.LastTestResult.TestedAt.ToLocalTime():HH:mm}";
        }
    }

    internal string BadgeClass
    {
        get
        {
            if (Config is null || !Config.IsConfigured)
                return "bg-gray-800 text-gray-400";

            if (Config.LastTestResult is null)
                return "bg-amber-900 text-amber-300";

            return Config.LastTestResult.IsSuccess
                ? "bg-emerald-900 text-emerald-300"
                : "bg-red-900 text-red-300";
        }
    }
}
