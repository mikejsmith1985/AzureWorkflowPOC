@* Connector configuration modal — four ConnectorSection panels, status badge row, Save All / Close (T024, T033). *@
@inject IConnectorConfigRepository ConfigRepo

@if (_isVisible)
{
    @* ── Backdrop ───────────────────────────────────────────────────── *@
    <div class="fixed inset-0 z-50 flex items-start justify-center pt-16 px-4"
         style="background:rgba(0,0,0,.7)">

        @* ── Modal panel ────────────────────────────────────────────── *@
        <div class="bg-gray-900 border border-gray-700 rounded-xl shadow-2xl w-full max-w-2xl max-h-[80vh] overflow-y-auto">

            @* Header *@
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-700 sticky top-0 bg-gray-900 z-10">
                <h2 class="text-base font-semibold text-gray-100">Connector Configuration</h2>
                <button @onclick="Close"
                        class="text-gray-500 hover:text-gray-300 transition-colors text-xl leading-none">
                    ×
                </button>
            </div>

            @* ── Status badge overview row (T033, US3) ───────────────── *@
            <div class="px-6 py-3 border-b border-gray-800 flex flex-wrap gap-2">
                @foreach (var config in _configs)
                {
                    <ConnectorStatusBadge ConnectorType="config.Type" Config="config" />
                }
                @if (_configs.Count == 0)
                {
                    @foreach (ConnectorType ct in Enum.GetValues<ConnectorType>())
                    {
                        <ConnectorStatusBadge ConnectorType="ct" Config="null" />
                    }
                }
            </div>

            @* Save feedback banner *@
            @if (_saveMessage is not null)
            {
                <div class="mx-6 mt-4 px-3 py-2 rounded text-xs @(_saveSuccess ? "bg-emerald-950 text-emerald-300" : "bg-red-950 text-red-300")">
                    @_saveMessage
                </div>
            }

            @* ── Connector sections ──────────────────────────────────── *@
            <div class="px-6 py-4">
                @if (_isLoading)
                {
                    <div class="text-gray-500 text-sm py-8 text-center">Loading configuration…</div>
                }
                else
                {
                    <ConnectorSection @ref="_snowSection"
                                      ConnectorType="ConnectorType.ServiceNow"
                                      Config="_configs.FirstOrDefault(c => c.Type == ConnectorType.ServiceNow)"
                                      OnSaved="OnSectionSaved" />

                    <ConnectorSection @ref="_adoSection"
                                      ConnectorType="ConnectorType.AzureDevOps"
                                      Config="_configs.FirstOrDefault(c => c.Type == ConnectorType.AzureDevOps)"
                                      OnSaved="OnSectionSaved" />

                    <ConnectorSection @ref="_llmSection"
                                      ConnectorType="ConnectorType.LLM"
                                      Config="_configs.FirstOrDefault(c => c.Type == ConnectorType.LLM)"
                                      OnSaved="OnSectionSaved" />

                    <ConnectorSection @ref="_teamsSection"
                                      ConnectorType="ConnectorType.Teams"
                                      Config="_configs.FirstOrDefault(c => c.Type == ConnectorType.Teams)"
                                      OnSaved="OnSectionSaved" />
                }
            </div>

            @* ── Footer buttons ──────────────────────────────────────── *@
            <div class="px-6 py-4 border-t border-gray-700 flex justify-end gap-3 sticky bottom-0 bg-gray-900">
                <button @onclick="Close"
                        class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm rounded transition-colors">
                    Close
                </button>
                <button @onclick="SaveAllAsync" disabled="@_isSaving"
                        class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-40
                               text-white text-sm rounded transition-colors">
                    @(_isSaving ? "Saving…" : "Save All")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private bool _isLoading;
    private bool _isSaving;
    private string? _saveMessage;
    private bool _saveSuccess;
    private List<ConnectorConfig> _configs = new();

    // Component refs for Save All (T024).
    private ConnectorSection _snowSection  = default!;
    private ConnectorSection _adoSection   = default!;
    private ConnectorSection _llmSection   = default!;
    private ConnectorSection _teamsSection = default!;

    /// <summary>Opens the modal and refreshes config from the repository.</summary>
    public async Task Open()
    {
        _isVisible   = true;
        _saveMessage = null;
        await LoadConfigsAsync();
        StateHasChanged();
    }

    /// <summary>Closes the modal without saving.</summary>
    public void Close()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task LoadConfigsAsync()
    {
        _isLoading = true;
        _configs   = (await ConfigRepo.GetAllAsync()).ToList();
        _isLoading = false;
    }

    /// <summary>Calls TrySaveAsync on every section; aborts on the first validation failure.</summary>
    private async Task SaveAllAsync()
    {
        _isSaving    = true;
        _saveMessage = null;
        try
        {
            var sections = new[] { _snowSection, _adoSection, _llmSection, _teamsSection };
            foreach (var section in sections)
            {
                var savedOk = await section.TrySaveAsync();
                if (!savedOk)
                {
                    _saveSuccess = false;
                    _saveMessage = "One or more sections have validation errors — please correct them before saving.";
                    return;
                }
            }
            _saveSuccess = true;
            _saveMessage = "All connectors saved successfully.";
            await LoadConfigsAsync(); // Refresh status badges
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>Refreshes the status badge row after a single section is saved.</summary>
    private async Task OnSectionSaved()
    {
        await LoadConfigsAsync();
        StateHasChanged();
    }
}
