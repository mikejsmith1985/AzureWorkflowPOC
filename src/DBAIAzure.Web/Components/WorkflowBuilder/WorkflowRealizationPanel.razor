@* Right-hand review panel that lists the assistant's per-node realization proposals in plain language
   and lets the user accept them all with a single explicit confirmation (US1). Per-proposal review
   controls (edit/reject/regenerate) are layered on in US2. *@

@using DBAIAzure.Core.Models
@using DBAIAzure.Core.Models.NodeConfig

@if (IsOpen)
{
    <div class="realization-panel w-96 bg-gray-900 border-l border-gray-800 flex flex-col h-full"
         role="complementary" aria-label="Make it real — review proposals"
         data-testid="realization-panel">

        @* ── Header ─────────────────────────────────────────────────────────────── *@
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-800">
            <h2 class="text-sm font-semibold text-gray-100">Make it real — review</h2>
            <button @onclick="OnCloseRequested"
                    class="text-gray-400 hover:text-gray-200 text-lg leading-none"
                    aria-label="Close the realization review panel"
                    title="Close">×</button>
        </div>

        @* ── Body ───────────────────────────────────────────────────────────────── *@
        <div class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
            @if (IsBusy)
            {
                <p class="text-xs text-cyan-400" role="status" aria-live="polite">
                    Turning your steps into production-ready configuration…
                </p>
            }

            @if (Proposals.Count == 0 && !IsBusy)
            {
                <EmptyState IsCompact="true" Icon="✨" IconLabel="no proposals" Title="No proposals yet"
                            Description="Make your workflow real to see production-ready configuration here." />
            }

            @foreach (var proposal in Proposals)
            {
                <div class="rounded-md border border-gray-800 bg-gray-850 p-3"
                     data-testid="realization-proposal"
                     aria-label="@($"Proposal for node {proposal.NodeId}")">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-medium text-gray-200">@FriendlyType(proposal.NodeType)</span>
                        <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded @StatusClass(proposal.Status)">
                            @FriendlyStatus(proposal.Status)
                        </span>
                    </div>
                    <p class="text-xs text-gray-400 leading-snug">@proposal.PlainLanguageSummary</p>
                    @if (!string.IsNullOrWhiteSpace(proposal.BlockingReason))
                    {
                        <p class="text-[11px] text-amber-400 mt-1">@proposal.BlockingReason</p>
                    }

                    @* Inline plain-language editor (no raw code/schema) for this proposal. *@
                    @if (_editingNodeId == proposal.NodeId)
                    {
                        <textarea @bind="_editBuffer"
                                  data-testid="proposal-edit-input"
                                  class="w-full mt-2 text-xs bg-gray-950 border border-gray-700 rounded p-2 text-gray-200
                                         focus:outline-none focus:border-cyan-500"
                                  rows="3"
                                  aria-label="Edit this step in plain language"></textarea>
                        <div class="flex gap-2 mt-1">
                            <button @onclick="() => SaveEdit(proposal)"
                                    data-testid="proposal-edit-save"
                                    class="flex-1 px-2 py-1 rounded text-[11px] bg-green-700 hover:bg-green-600 text-white"
                                    aria-label="Save edit and accept this step">Save &amp; accept</button>
                            <button @onclick="() => _editingNodeId = null"
                                    class="flex-1 px-2 py-1 rounded text-[11px] bg-gray-700 hover:bg-gray-600 text-gray-200"
                                    aria-label="Cancel editing this step">Cancel</button>
                        </div>
                    }
                    else
                    {
                        @* Per-proposal review controls (US2): Accept / Edit / Reject / Regenerate. *@
                        <div class="flex flex-wrap gap-1.5 mt-2">
                            @if (proposal.Status == NodeRealizationStatus.Proposed && proposal.ProposedConfig is not null)
                            {
                                <button @onclick="() => OnAcceptOne.InvokeAsync(proposal)"
                                        data-testid="proposal-accept"
                                        class="px-2 py-0.5 rounded text-[11px] bg-cyan-700 hover:bg-cyan-600 text-white"
                                        aria-label="Accept this step">Accept</button>
                                @if (PrimaryEditableText(proposal) is not null)
                                {
                                    <button @onclick="() => BeginEdit(proposal)"
                                            data-testid="proposal-edit"
                                            class="px-2 py-0.5 rounded text-[11px] bg-gray-700 hover:bg-gray-600 text-gray-200"
                                            aria-label="Edit this step before accepting">Edit</button>
                                }
                            }
                            <button @onclick="() => OnRejectOne.InvokeAsync(proposal)"
                                    data-testid="proposal-reject"
                                    class="px-2 py-0.5 rounded text-[11px] bg-gray-700 hover:bg-gray-600 text-gray-200"
                                    aria-label="Reject this step">Reject</button>
                            <button @onclick="() => OnRegenerateOne.InvokeAsync(proposal)"
                                    data-testid="proposal-regenerate"
                                    class="px-2 py-0.5 rounded text-[11px] bg-gray-700 hover:bg-gray-600 text-gray-200"
                                    aria-label="Ask for a different proposal for this step">Regenerate</button>
                        </div>
                    }
                </div>
            }
        </div>

        @* ── Footer: single explicit Accept-all confirmation ────────────────────── *@
        <div class="px-4 py-3 border-t border-gray-800 space-y-2">
            @if (AcceptableCount > 0)
            {
                <p class="text-[11px] text-gray-500">
                    @AcceptableCount of @Proposals.Count step(s) are ready to apply.
                </p>
            }
            @if (!_isConfirming)
            {
                <button @onclick="() => _isConfirming = true"
                        disabled="@(IsBusy || AcceptableCount == 0)"
                        data-testid="accept-all"
                        class="w-full px-3 py-1.5 rounded-md text-sm font-medium
                               @(IsBusy || AcceptableCount == 0
                                   ? "bg-gray-700 text-gray-500 cursor-not-allowed"
                                   : "bg-cyan-600 hover:bg-cyan-500 text-white")"
                        aria-label="Accept all proposals">
                    Accept all
                </button>
            }
            else
            {
                <p class="text-xs text-gray-300">Apply @AcceptableCount proposal(s) to your workflow?</p>
                <div class="flex gap-2">
                    <button @onclick="ConfirmAcceptAll"
                            data-testid="accept-all-confirm"
                            class="flex-1 px-3 py-1.5 rounded-md text-sm bg-green-600 hover:bg-green-500 text-white"
                            aria-label="Confirm — apply all proposals">
                        Confirm
                    </button>
                    <button @onclick="() => _isConfirming = false"
                            class="flex-1 px-3 py-1.5 rounded-md text-sm bg-gray-700 hover:bg-gray-600 text-gray-200"
                            aria-label="Cancel applying proposals">
                        Cancel
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Whether the panel is visible.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>True while proposals are still being generated, so the UI shows progress and disables apply.</summary>
    [Parameter] public bool IsBusy { get; set; }

    /// <summary>The proposals to review, in graph order.</summary>
    [Parameter] public IReadOnlyList<RealizationProposal> Proposals { get; set; } = Array.Empty<RealizationProposal>();

    /// <summary>Raised when the user confirms applying every acceptable proposal.</summary>
    [Parameter] public EventCallback OnAcceptAll { get; set; }

    /// <summary>Raised when the user accepts a single proposal as-is.</summary>
    [Parameter] public EventCallback<RealizationProposal> OnAcceptOne { get; set; }

    /// <summary>Raised when the user rejects a single proposal (its node keeps its prior state).</summary>
    [Parameter] public EventCallback<RealizationProposal> OnRejectOne { get; set; }

    /// <summary>Raised when the user asks for a fresh proposal for a single node.</summary>
    [Parameter] public EventCallback<RealizationProposal> OnRegenerateOne { get; set; }

    /// <summary>Raised when the user accepts a single proposal after editing its plain-language text.</summary>
    [Parameter] public EventCallback<ProposalEdit> OnEditAccept { get; set; }

    /// <summary>Raised when the user closes the panel.</summary>
    [Parameter] public EventCallback OnCloseRequested { get; set; }

    /// <summary>Carries an edited proposal and the new plain-language text the user typed.</summary>
    public sealed record ProposalEdit(RealizationProposal Proposal, string EditedText);

    // Two-step confirm so a single accidental click never mutates the workflow.
    private bool _isConfirming;

    // The node currently being edited inline, and the working text for that edit.
    private string? _editingNodeId;
    private string  _editBuffer = string.Empty;

    private void BeginEdit(RealizationProposal proposal)
    {
        _editingNodeId = proposal.NodeId;
        _editBuffer    = PrimaryEditableText(proposal) ?? string.Empty;
    }

    private async Task SaveEdit(RealizationProposal proposal)
    {
        var editedText = _editBuffer;
        _editingNodeId = null;
        await OnEditAccept.InvokeAsync(new ProposalEdit(proposal, editedText));
    }

    /// <summary>
    /// The single plain-language field a user may edit for this proposal, or null for node types whose
    /// configuration is structural (route/transform/data) and not safely editable as free text.
    /// </summary>
    private static string? PrimaryEditableText(RealizationProposal proposal)
    {
        var configJson = proposal.ProposedConfig?.ConfigJson;
        if (string.IsNullOrWhiteSpace(configJson))
            return null;

        return proposal.NodeType switch
        {
            WorkflowNodeType.AgenticReason => ReadString(configJson, "instruction"),
            WorkflowNodeType.FunctionNotify => ReadString(configJson, "messageTemplate"),
            WorkflowNodeType.HumanApproval => ReadString(configJson, "promptShown"),
            WorkflowNodeType.Trigger        => ReadString(configJson, "initialDataDescription"),
            _                               => null,
        };
    }

    /// <summary>Reads a string property from a config JSON object (Web camelCase), or null if absent.</summary>
    private static string? ReadString(string configJson, string propertyName)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(configJson);
            return document.RootElement.TryGetProperty(propertyName, out var value)
                ? value.GetString()
                : null;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    /// <summary>How many proposals carry an applicable configuration (Proposed state with a config).</summary>
    private int AcceptableCount =>
        Proposals.Count(proposal =>
            proposal.Status == NodeRealizationStatus.Proposed && proposal.ProposedConfig is not null);

    private async Task ConfirmAcceptAll()
    {
        _isConfirming = false;
        await OnAcceptAll.InvokeAsync();
    }

    // ── Plain-language display helpers ────────────────────────────────────────────

    private static string FriendlyType(WorkflowNodeType nodeType) => nodeType switch
    {
        WorkflowNodeType.Trigger          => "Trigger",
        WorkflowNodeType.AgenticReason    => "AI step",
        WorkflowNodeType.FunctionRoute    => "Branch",
        WorkflowNodeType.FunctionTransform => "Transform",
        WorkflowNodeType.FunctionNotify   => "Notify",
        WorkflowNodeType.FunctionData     => "Data",
        WorkflowNodeType.HumanApproval    => "Approval",
        _                                 => nodeType.ToString(),
    };

    private static string FriendlyStatus(NodeRealizationStatus status) => status switch
    {
        NodeRealizationStatus.Proposed   => "Ready",
        NodeRealizationStatus.Realized   => "Realized",
        NodeRealizationStatus.Blocked    => "Blocked",
        NodeRealizationStatus.NeedsInput => "Needs input",
        NodeRealizationStatus.OutOfDate  => "Out of date",
        _                                => "Draft",
    };

    private static string StatusClass(NodeRealizationStatus status) => status switch
    {
        NodeRealizationStatus.Proposed or NodeRealizationStatus.Realized => "bg-green-900 text-green-300",
        NodeRealizationStatus.Blocked                                    => "bg-red-900 text-red-300",
        NodeRealizationStatus.NeedsInput or NodeRealizationStatus.OutOfDate => "bg-amber-900 text-amber-300",
        _                                                                => "bg-gray-700 text-gray-300",
    };
}
