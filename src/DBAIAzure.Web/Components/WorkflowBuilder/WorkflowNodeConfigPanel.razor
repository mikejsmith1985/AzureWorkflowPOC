    // ── References ─────────────────────────────────────────────────────────────────

    /// <summary>Adds a blank reference row for the operator to fill in.</summary>
    private void AddReference() => _references.Add(new ReferenceRow());

    /// <summary>Removes the reference row at the given index, ignoring out-of-range requests.</summary>
    private void RemoveReference(int index)
    {
        if (index >= 0 && index < _references.Count)
            _references.RemoveAt(index);
    }

    /// <summary>Maps the reference type dropdown's string value back to the enum, defaulting to Document.</summary>
    private static NodeReferenceType ParseRefType(string? value) =>
        Enum.TryParse<NodeReferenceType>(value, out var parsed) ? parsed : NodeReferenceType.Document;

    /// <summary>Placeholder text guiding what to enter for each non-document reference kind.</summary>
    private static string GetValuePlaceholder(NodeReferenceType type) => type switch
    {
        NodeReferenceType.Url       => "https://…",
        NodeReferenceType.Dashboard => "Dashboard URL or identifier",
        NodeReferenceType.Binary    => "Blob URI or artifact identifier",
        _                           => "Value",
    };

    /// <summary>Converts the editable rows into domain references, dropping any row with a blank name.</summary>
    private IReadOnlyList<NodeReference> BuildReferences() =>
        _references
            .Where(row => !string.IsNullOrWhiteSpace(row.Name))
            .Select(row => new NodeReference
            {
                Type = row.Type,
                Name = row.Name.Trim(),
                Value = row.Value,
            })
            .ToList();

