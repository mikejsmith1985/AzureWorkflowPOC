@* Top toolbar for the Visual Workflow Builder page.
   Exposes Save, Undo, Redo, snap-to-grid toggle, Chat, Settings, and Run/Stop buttons.
   Also provides: inline workflow-name editing (T033-T036), run-disabled reason (T030),
   canvas-changed indicator on the Chat button (T048), and the shortcuts "?" toggle (T064). *@

<div class="workflow-toolbar flex items-center gap-2 px-4 py-2 bg-gray-900 border-b border-gray-800">

    @* Workflow name — clickable to edit; amber when "Untitled Workflow" (T034) *@
    @if (_isEditingName)
    {
        <input @ref="_nameInputRef"
               value="@_editingNameValue"
               @oninput="@((e) => _editingNameValue = e.Value?.ToString() ?? string.Empty)"
               @onkeydown="OnNameKeyDown"
               @onblur="OnNameBlur"
               class="text-sm font-semibold bg-transparent border-b border-cyan-500 text-gray-100
                      focus:outline-none mr-2 max-w-[200px] px-0"
               aria-label="Edit workflow name" />
        @if (_showBlankNameTooltip)
        {
            <span class="text-xs text-amber-400 mr-1" role="alert">Name cannot be blank.</span>
        }
    }
    else
    {
        <span @onclick="StartNameEdit"
              class="text-sm font-semibold mr-2 truncate max-w-[200px] cursor-text hover:text-gray-100
                     @(string.IsNullOrWhiteSpace(WorkflowName) ? "text-amber-400" : "text-gray-200")"
              title="Click to rename"
              role="button"
              tabindex="0"
              aria-label="Rename workflow — click to edit">
            @(string.IsNullOrWhiteSpace(WorkflowName) ? "Untitled Workflow" : WorkflowName)
        </span>
    }

    <div class="h-4 border-l border-gray-700 mx-1"></div>

    @* Undo *@
    <button @onclick="OnUndoClicked"
            disabled="@(!CanUndo)"
            class="toolbar-btn @(CanUndo ? "" : "opacity-40 cursor-not-allowed")"
            aria-label="Undo last action (Ctrl+Z)"
            title="Undo (Ctrl+Z)">
        ↩
    </button>

    @* Redo *@
    <button @onclick="OnRedoClicked"
            disabled="@(!CanRedo)"
            class="toolbar-btn @(CanRedo ? "" : "opacity-40 cursor-not-allowed")"
            aria-label="Redo last undone action (Ctrl+Y)"
            title="Redo (Ctrl+Y)">
        ↪
    </button>

    <div class="h-4 border-l border-gray-700 mx-1"></div>

    @* Snap/Free toggle *@
    <button @onclick="OnSnapToggleClicked"
            class="toolbar-btn @(IsSnapping ? "text-cyan-400" : "text-gray-400")"
            aria-label="@(IsSnapping ? "Currently snapping to grid — click for free movement" : "Currently free movement — click to snap to grid")"
            title="@(IsSnapping ? "Snap to grid (active)" : "Free move (active)")">
        ⊞ @(IsSnapping ? "Snap to grid" : "Free move")
    </button>

    <div class="h-4 border-l border-gray-700 mx-1"></div>

    @* Save button *@
    <button @ref="SaveButtonRef"
            @onclick="OnSaveClicked"
            class="toolbar-btn text-cyan-400 hover:text-cyan-300"
            aria-label="Save workflow (Ctrl+S)"
            title="Save (Ctrl+S)">
        💾 Save
    </button>

    @* Auto-saved timestamp *@
    @if (LastSavedAt.HasValue)
    {
        <span class="text-xs text-gray-500" aria-live="polite">
            Auto-saved @LastSavedAt.Value.ToString("HH:mm:ss")
        </span>
    }

    @* Execution timeout display *@
    @if (ExecutionTimeoutMinutes > 0)
    {
        <span class="text-xs text-gray-600" aria-label="Execution timeout">
            ⏱ @ExecutionTimeoutMinutes min
        </span>
    }

    <div class="flex-1"></div>

    @* Chat toggle — shows an orange dot badge when canvas has changed since last codegen (T048) *@
    <button @onclick="OnChatToggleClicked"
            class="toolbar-btn @(IsChatOpen ? "text-purple-400" : "text-gray-400") relative"
            aria-label="@(IsChatOpen ? "Close chat panel" : "Open chat panel")"
            title="AI Chat">
        💬 Chat
        @if (HasCanvasChangedSinceCodeGen)
        {
            <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-orange-500 rounded-full border border-gray-900"
                  aria-label="Workflow has changed since code was generated"></span>
        }
    </button>

    @* Settings *@
    <button @onclick="OnSettingsClicked"
            class="toolbar-btn text-gray-400 hover:text-gray-200"
            aria-label="Workflow settings"
            title="Settings">
        ⚙️
    </button>

    <div class="h-4 border-l border-gray-700 mx-1"></div>

    @* Run / Stop — with disabled-reason text label (T030) *@
    <div class="flex items-center gap-2">
        @if (!string.IsNullOrEmpty(RunDisabledReason))
        {
            <span class="text-xs text-amber-400 max-w-[180px] leading-tight" role="status" aria-live="polite">
                @RunDisabledReason
            </span>
        }
        @if (IsRunning)
        {
            <button @onclick="OnStopClicked"
                    class="toolbar-btn bg-red-600 hover:bg-red-500 text-white px-3 py-1 rounded-md text-sm"
                    aria-label="Stop the running workflow"
                    title="Stop run">
                ⏹ Stop
            </button>
        }
        else
        {
            <button @onclick="OnRunClicked"
                    disabled="@(!(CanRun && !IsTriggerMissing))"
                    class="toolbar-btn run-btn-ready @(CanRun && !IsTriggerMissing ? "bg-green-600 hover:bg-green-500 text-white" : "bg-gray-700 text-gray-500 cursor-not-allowed") px-3 py-1 rounded-md text-sm"
                    aria-label="@RunButtonAriaLabel"
                    title="@RunButtonTitle">
                ▶ Run
            </button>
        }
    </div>

    <div class="h-4 border-l border-gray-700 mx-1"></div>

    @* Keyboard shortcuts panel toggle — "?" button (T064) *@
    <div class="relative">
        <button @onclick="OnShortcutsToggleClicked"
                class="toolbar-btn text-gray-400 hover:text-gray-200 text-base font-bold"
                aria-label="Show keyboard shortcuts"
                title="Keyboard shortcuts">
            ?
        </button>
        <WorkflowKeyboardShortcutsPanel IsOpen="@IsShortcutsPanelOpen"
                                        OnCloseRequested="@OnShortcutsToggleClicked" />
    </div>
</div>

<style>
    .toolbar-btn {
        @* Base styles shared by all toolbar buttons — Tailwind classes applied inline *@
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.875rem;
        transition: all 0.15s;
        cursor: pointer;
    }
    .toolbar-btn:not(:disabled):hover {
        background-color: rgba(156, 163, 175, 0.1);
    }
    .run-btn-ready {
        transition: background-color 300ms ease-in-out, color 300ms ease-in-out;
    }
</style>

@code {
    // ── Data parameters ──────────────────────────────────────────────────────────

    [Parameter] public string? WorkflowName           { get; set; }
    [Parameter] public bool    CanUndo                { get; set; }
    [Parameter] public bool    CanRedo                { get; set; }
    [Parameter] public bool    IsSnapping             { get; set; }
    [Parameter] public bool    IsRunning              { get; set; }
    [Parameter] public bool    CanRun                 { get; set; }
    [Parameter] public bool    IsTriggerMissing       { get; set; }
    [Parameter] public bool    IsChatOpen             { get; set; }
    [Parameter] public DateTimeOffset? LastSavedAt    { get; set; }
    [Parameter] public int     ExecutionTimeoutMinutes{ get; set; }

    /// <summary>
    /// When true, an orange dot badge appears on the Chat button to indicate the canvas
    /// has changed since the last code generation (T048).
    /// </summary>
    [Parameter] public bool HasCanvasChangedSinceCodeGen { get; set; }

    /// <summary>Whether the keyboard shortcuts panel is open (T064).</summary>
    [Parameter] public bool IsShortcutsPanelOpen { get; set; }

    // ── Callback parameters ──────────────────────────────────────────────────────

    [Parameter] public EventCallback OnUndoClicked          { get; set; }
    [Parameter] public EventCallback OnRedoClicked          { get; set; }
    [Parameter] public EventCallback OnSnapToggleClicked    { get; set; }
    [Parameter] public EventCallback OnSaveClicked          { get; set; }
    [Parameter] public EventCallback OnChatToggleClicked    { get; set; }
    [Parameter] public EventCallback OnSettingsClicked      { get; set; }
    [Parameter] public EventCallback OnRunClicked           { get; set; }
    [Parameter] public EventCallback OnStopClicked          { get; set; }
    [Parameter] public EventCallback<string> OnNameChanged  { get; set; }
    [Parameter] public EventCallback OnShortcutsToggleClicked { get; set; }

    // ── Exposed element refs for focus management ─────────────────────────────────

    /// <summary>
    /// Ref to the Save button; used by the parent page to focus it after the
    /// unsaved-changes modal directs the user to save (T045).
    /// </summary>
    public ElementReference SaveButtonRef { get; private set; }

    // ── Local state — inline name editing (T033) ─────────────────────────────────

    private bool   _isEditingName;
    private string _editingNameValue  = string.Empty;
    private bool   _showBlankNameTooltip;
    private string _previousName      = string.Empty;
    private ElementReference _nameInputRef;
    private System.Threading.CancellationTokenSource? _blankTooltipCts;

    // ── Derived display helpers ──────────────────────────────────────────────────

    private string RunButtonAriaLabel =>
        IsTriggerMissing ? "Add a starting trigger node before running" :
        CanRun           ? "Run this workflow" :
                           "Configure all nodes before running";

    private string RunButtonTitle =>
        IsTriggerMissing ? "Add a starting trigger before running" :
        CanRun           ? "Run workflow" :
                           "All nodes must be configured before running";

    /// <summary>
    /// Plain-language reason why Run is disabled. Empty when the button is enabled (T030).
    /// </summary>
    private string RunDisabledReason =>
        IsTriggerMissing         ? "Needs a trigger to start" :
        !CanRun && !IsRunning    ? "Set up all steps first" :
                                    string.Empty;

    // ── Inline name editing (T034/T035) ─────────────────────────────────────────

    private void StartNameEdit()
    {
        _previousName      = WorkflowName ?? string.Empty;
        _editingNameValue  = _previousName;
        _isEditingName     = true;
        _showBlankNameTooltip = false;
    }

    private async Task CommitNameEdit()
    {
        if (string.IsNullOrWhiteSpace(_editingNameValue))
        {
            // Blank name: revert to previous value and flash a 1-second tooltip.
            _editingNameValue     = _previousName;
            _showBlankNameTooltip = true;
            _isEditingName        = false;

            _blankTooltipCts?.Cancel();
            _blankTooltipCts = new System.Threading.CancellationTokenSource();
            var token = _blankTooltipCts.Token;
            _ = Task.Delay(1000, token).ContinueWith(_ =>
            {
                if (!token.IsCancellationRequested)
                    InvokeAsync(() => { _showBlankNameTooltip = false; StateHasChanged(); });
            }, System.Threading.CancellationToken.None,
               TaskContinuationOptions.OnlyOnRanToCompletion,
               TaskScheduler.Default);
            return;
        }

        _isEditingName = false;
        await OnNameChanged.InvokeAsync(_editingNameValue);
    }

    private void CancelNameEdit()
    {
        _editingNameValue = _previousName;
        _isEditingName    = false;
        _showBlankNameTooltip = false;
    }

    private async Task OnNameKeyDown(KeyboardEventArgs keyArgs)
    {
        if (keyArgs.Key == "Enter")  await CommitNameEdit();
        else if (keyArgs.Key == "Escape") CancelNameEdit();
    }

    private async Task OnNameBlur() => await CommitNameEdit();
}
