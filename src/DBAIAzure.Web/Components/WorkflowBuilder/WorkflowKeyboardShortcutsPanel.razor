@* Floating keyboard shortcuts panel — shown when the user clicks the "?" button in the toolbar.
   Lists all canvas keyboard shortcuts; closed by Escape or clicking outside. *@

@if (!IsOpen)
{
    return;
}

@* Invisible backdrop to dismiss on outside click (same pattern as canvas context menu) *@
<div class="fixed inset-0 z-40" @onclick="ClosePanel"></div>

<div class="absolute right-2 top-12 z-50 bg-gray-800 border border-gray-700 rounded-xl
            shadow-2xl p-4 w-64 flex flex-col gap-3"
     role="dialog" aria-modal="true" aria-label="Keyboard shortcuts"
     @onkeydown="OnKeyDown" tabindex="-1">

    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Keyboard Shortcuts</h3>

    <dl class="flex flex-col gap-2">
        <div class="flex items-center justify-between">
            <dt class="text-xs text-gray-300">Undo last action</dt>
            <dd><kbd class="px-1.5 py-0.5 text-xs bg-gray-700 rounded font-mono text-gray-200">Ctrl+Z</kbd></dd>
        </div>
        <div class="flex items-center justify-between">
            <dt class="text-xs text-gray-300">Redo last action</dt>
            <dd><kbd class="px-1.5 py-0.5 text-xs bg-gray-700 rounded font-mono text-gray-200">Ctrl+Y</kbd></dd>
        </div>
        <div class="flex items-center justify-between">
            <dt class="text-xs text-gray-300">Delete selected</dt>
            <dd class="flex gap-1">
                <kbd class="px-1.5 py-0.5 text-xs bg-gray-700 rounded font-mono text-gray-200">Delete</kbd>
                <span class="text-xs text-gray-500">/</span>
                <kbd class="px-1.5 py-0.5 text-xs bg-gray-700 rounded font-mono text-gray-200">Backspace</kbd>
            </dd>
        </div>
        <div class="flex items-center justify-between">
            <dt class="text-xs text-gray-300">Save</dt>
            <dd><kbd class="px-1.5 py-0.5 text-xs bg-gray-700 rounded font-mono text-gray-200">Ctrl+S</kbd></dd>
        </div>
    </dl>
</div>

@code {
    /// <summary>Controls whether this panel is visible. Toggled by the "?" button in the toolbar.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Raised when the panel should close (Escape key or outside-click).</summary>
    [Parameter] public EventCallback OnCloseRequested { get; set; }

    private async Task ClosePanel() => await OnCloseRequested.InvokeAsync();

    private async Task OnKeyDown(KeyboardEventArgs keyArgs)
    {
        if (keyArgs.Key == "Escape")
            await OnCloseRequested.InvokeAsync();
    }
}
