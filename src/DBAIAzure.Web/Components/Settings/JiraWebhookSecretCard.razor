@* Credential card for the inbound Jira webhook that starts the DoR workflow. Holds ONLY the HMAC signing
   secret — every behavioural setting now lives on the workflow's own nodes in the Workflow Builder. A secret
   cannot live on a node (node config is stored in plain text with the workflow graph), so it stays here on the
   credentials page, encrypted at rest. *@
@inject IConnectorConfigRepository ConfigRepository
@inject IConnectorHealthChecker HealthChecker
@inject ILogger<JiraWebhookSecretCard> Logger
@using System.Text.Json.Nodes
@using DBAIAzure.Core.Interfaces
@using DBAIAzure.Core.Models

<div class="rounded bg-surface border border-line p-5" data-testid="jira-webhook-secret-card">
    <!-- ── Header ──────────────────────────────────────────────── -->
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-fg">Jira Webhook</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-raised text-muted">DoR trigger</span>
            @if (_testResult is not null)
            {
                var badgeClass = _testResult.IsSuccess ? "bg-ok-subtle text-ok" : "bg-err-subtle text-err";
                <span class="text-xs px-2 py-0.5 rounded-full @badgeClass">
                    @(_testResult.IsSuccess ? "Ready" : "Not ready")
                </span>
            }
        </div>
        <div class="flex gap-2">
            <button @onclick="ToggleEdit"
                    class="px-3 py-1.5 text-xs rounded bg-raised hover:bg-surface text-fg transition-colors">
                @(_isEditing ? "Cancel" : "Edit")
            </button>
            <button @onclick="RunHealthCheck" disabled="@_isChecking"
                    class="px-3 py-1.5 text-xs rounded bg-accent hover:opacity-90 disabled:opacity-40
                           disabled:cursor-not-allowed text-onaccent transition-colors">
                @(_isChecking ? "Checking…" : "Check Workflow")
            </button>
        </div>
    </div>

    <!-- ── Explanation / last readiness result ─────────────────── -->
    @if (_testResult is { Message: { Length: > 0 } healthMessage })
    {
        <p class="text-xs text-muted mb-3">@healthMessage · @FormatAge(_testResult.TestedAt)</p>
    }
    else
    {
        <p class="text-xs text-muted mb-3">
            Signing secret for the inbound Jira webhook that starts the DoR workflow. Everything the workflow
            <em>does</em> — the Definition of Ready, project scope, channels, SLAs — is configured on its steps in
            the Workflow Builder.
        </p>
    }

    <!-- ── Edit form ──────────────────────────────────────────── -->
    @if (_isEditing)
    {
        <div class="mt-3 space-y-3 border-t border-line pt-3">
            <div>
                <label class="block text-xs text-muted mb-1">Jira Webhook Secret (HMAC)</label>
                <input type="password" @bind="_draftSecret" autocomplete="new-password"
                       placeholder="Leave blank to keep existing" class="@InputClass"
                       data-testid="jira-webhook-secret" />
                <p class="text-[11px] text-muted mt-1">
                    Stored encrypted; a blank field keeps the existing value.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_saveError))
            {
                <p class="text-xs text-err" data-testid="webhook-save-error">@_saveError</p>
            }

            <div class="flex gap-2 pt-1">
                <button @onclick="Save" disabled="@_isSaving"
                        class="px-4 py-1.5 text-xs rounded bg-accent hover:opacity-90 disabled:opacity-40 text-onaccent transition-colors">
                    @(_isSaving ? "Saving…" : "Save")
                </button>
                <button @onclick="ToggleEdit"
                        class="px-3 py-1.5 text-xs rounded bg-raised hover:bg-surface text-fg transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const string InputClass =
        "w-full bg-raised border border-line rounded px-3 py-2 text-sm text-fg " +
        "placeholder-muted focus:outline-none focus:border-accent";

    private bool _isEditing;
    private bool _isSaving;
    private bool _isChecking;
    private string _saveError = string.Empty;
    private ConnectorTestResult? _testResult;

    // Never pre-populated from storage (Article IX); blank means "keep the stored value".
    private string _draftSecret = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var config = await ConfigRepository.GetAsync(ConnectorType.DorWorkflow);
        _testResult = config?.LastTestResult;
    }

    private void ToggleEdit()
    {
        _isEditing = !_isEditing;
        _draftSecret = string.Empty;
        _saveError = string.Empty;
    }

    /// <summary>Persists the webhook signing secret, leaving the workflow's node-held configuration untouched.</summary>
    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_draftSecret))
        {
            _isEditing = false; // Nothing typed — keep the stored secret.
            return;
        }

        _isSaving = true;
        _saveError = string.Empty;
        StateHasChanged();

        try
        {
            var existing = await ConfigRepository.GetAsync(ConnectorType.DorWorkflow);
            var secretJson = new JsonObject { ["jira_webhook_secret"] = _draftSecret }.ToJsonString();

            // Preserve any existing non-secret config so an older install's fallback values are not wiped.
            await ConfigRepository.SaveAsync(
                ConnectorType.DorWorkflow, existing?.NonSecretConfig ?? "{}", secretJson);

            _draftSecret = string.Empty;
            _isEditing = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save the Jira webhook secret");
            _saveError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>Checks whether the DoR workflow — now configured from its nodes — is ready to run.</summary>
    private async Task RunHealthCheck()
    {
        _isChecking = true;
        StateHasChanged();
        try
        {
            _testResult = await HealthChecker.TestAsync(ConnectorType.DorWorkflow);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "DoR workflow readiness check threw");
        }
        finally
        {
            _isChecking = false;
        }
    }

    private static string FormatAge(DateTimeOffset at)
    {
        var age = DateTimeOffset.UtcNow - at;
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h ago";
        return $"{(int)age.TotalDays}d ago";
    }
}
