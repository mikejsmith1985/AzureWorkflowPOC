@* First-run onboarding banner (spec-009 US3). Renders only while the LLM connector is not yet
   healthy and the user hasn't dismissed it. The LLM key is the one required step; the other
   connectors are optional. Dismissal is persisted in localStorage via IOnboardingStateService. *@
@inject IOnboardingStateService Onboarding
@using DBAIAzure.Web.Services

@if (Onboarding.State.ShouldShow)
{
    <div class="section-enter px-6 pt-4" data-testid="onboarding-banner">
        <div class="max-w-6xl mx-auto rounded-lg border border-cyan-800/60 bg-cyan-950/40 p-4 flex items-start gap-4">
            <span class="text-2xl leading-none" role="img" aria-label="wave">👋</span>
            <div class="flex-1 min-w-0">
                <h2 class="text-sm font-semibold text-cyan-200">Welcome — let's get you running</h2>
                <p class="text-xs text-gray-400 mt-0.5">
                    Add your own LLM API key to start running workflows. The other connectors are optional.
                </p>
                <div class="flex flex-wrap items-center gap-2 mt-3">
                    <a href="/settings/connectors?expand=LLM"
                       class="px-3 py-1.5 text-xs rounded bg-cyan-700 hover:bg-cyan-600 text-white font-medium transition-colors">
                        Add your LLM key — required
                    </a>
                    @foreach (var optional in _optionalSteps)
                    {
                        <a href="@($"/settings/connectors?expand={optional.Key}")"
                           class="px-2.5 py-1.5 text-xs rounded bg-gray-800 hover:bg-gray-700 text-gray-300 transition-colors">
                            @optional.Label <span class="text-gray-500">· optional</span>
                        </a>
                    }
                </div>
            </div>
            <button @onclick="DismissAsync"
                    aria-label="Dismiss onboarding banner"
                    class="text-gray-500 hover:text-gray-300 transition-colors shrink-0">✕</button>
        </div>
    </div>
}

@code {
    // The three optional connectors a visitor may configure after the required LLM key.
    private static readonly (string Key, string Label)[] _optionalSteps =
    {
        ("ServiceNow", "ServiceNow"),
        ("WorkTracker", "Work Tracking System"),
        ("Messaging", "Messaging"),
    };

    /// <summary>Permanently dismisses the banner and re-renders so it disappears immediately.</summary>
    private async Task DismissAsync()
    {
        await Onboarding.DismissAsync();
        StateHasChanged();
    }
}
