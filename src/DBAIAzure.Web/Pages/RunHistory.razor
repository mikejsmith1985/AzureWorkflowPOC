@* Execution History list page: searchable, filterable list of all workflow builder runs (FR-20, US4). *@
@page "/runs"
@inject IWorkflowRunRepository RunRepository
@using DBAIAzure.Core.Interfaces
@using DBAIAzure.Core.Models

<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-fg">Run History</h1>
    <span class="text-sm text-muted">@_runs.Count total</span>
</div>

<!-- ── Search + filter ─────────────────────────────────────────────────── -->
<div class="flex flex-wrap gap-3 mb-4">
    <input type="search"
           placeholder="Search workflow name or run ID…"
           @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter"
           class="flex-1 min-w-48 bg-surface border border-line rounded px-3 py-2 text-sm
                  text-fg placeholder-muted focus:outline-none focus:border-accent" />

    <select @bind="_statusFilter" @bind:after="ApplyFilter"
            class="bg-surface border border-line rounded px-3 py-2 text-sm text-fg
                   focus:outline-none focus:border-accent">
        <option value="">All Statuses</option>
        @foreach (WorkflowRunStatus s in Enum.GetValues<WorkflowRunStatus>())
        {
            <option value="@s">@s</option>
        }
    </select>
</div>

<!-- ── Run list table ─────────────────────────────────────────────────── -->
@if (_loading)
{
    <div class="text-muted text-sm">Loading…</div>
}
else if (_filtered.Count == 0)
{
    <div class="text-muted text-sm">No runs match the current filter.</div>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-xs text-muted border-b border-line">
                    <th class="pb-2 pr-4 font-medium">Workflow</th>
                    <th class="pb-2 pr-4 font-medium">Run ID</th>
                    <th class="pb-2 pr-4 font-medium">Status</th>
                    <th class="pb-2 pr-4 font-medium">Started</th>
                    <th class="pb-2 pr-4 font-medium">Duration</th>
                    <th class="pb-2 font-medium"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in _filtered)
                {
                    <tr class="border-b border-line hover:bg-surface transition-colors">
                        <td class="py-3 pr-4 text-fg font-medium truncate max-w-48">@run.WorkflowName</td>
                        <td class="py-3 pr-4 font-mono text-muted text-xs">@run.RunId</td>
                        <td class="py-3 pr-4">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @StatusClass(run.Status)">
                                @run.Status
                            </span>
                        </td>
                        <td class="py-3 pr-4 text-muted text-xs whitespace-nowrap">
                            @run.StartedAt.ToLocalTime().ToString("MMM d HH:mm")
                        </td>
                        <td class="py-3 pr-4 text-muted text-xs">@FormatDuration(run)</td>
                        <td class="py-3">
                            <a href="/runs/@run.RunId"
                               class="text-xs text-accent hover:text-accent transition-colors">
                                Details →
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private List<WorkflowRunRecord> _runs = new();
    private List<WorkflowRunRecord> _filtered = new();

    protected override async Task OnInitializedAsync()
    {
        _runs   = (await RunRepository.ListAsync()).ToList();
        _loading = false;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = _runs
            .Where(r =>
                (string.IsNullOrEmpty(q)
                    || r.WorkflowName.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || r.RunId.Contains(q, StringComparison.OrdinalIgnoreCase))
                && (string.IsNullOrEmpty(_statusFilter)
                    || r.Status.ToString() == _statusFilter))
            .ToList();
    }

    private static string StatusClass(WorkflowRunStatus status) => status switch
    {
        WorkflowRunStatus.Running    => "bg-accent-subtle text-accent",
        WorkflowRunStatus.Paused     => "bg-warn-subtle text-warn",
        WorkflowRunStatus.Completed  => "bg-ok-subtle text-ok",
        WorkflowRunStatus.Failed     => "bg-err-subtle text-err",
        WorkflowRunStatus.TimedOut   => "bg-warn-subtle text-warn",
        WorkflowRunStatus.Cancelled  => "bg-raised text-muted",
        _                            => "bg-raised text-muted",
    };

    private static string FormatDuration(WorkflowRunRecord run)
    {
        var end = run.CompletedAt ?? DateTimeOffset.UtcNow;
        var span = end - run.StartedAt;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{(int)span.TotalHours}h {span.Minutes}m";
    }
}
