@page "/new-ticket"
@inject PipelineOrchestrator Orchestrator
@inject NavigationManager Nav

<h1 class="text-xl font-semibold text-gray-100 mb-6">Submit a Ticket</h1>

<div class="bg-gray-900 border border-gray-800 rounded-lg p-6 max-w-2xl">
    <EditForm Model="@_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-4">
            <label class="block text-sm text-gray-400 mb-1">Ticket ID</label>
            <InputText @bind-Value="_model.TicketId"
                       class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100
                              focus:outline-none focus:border-cyan-500 text-sm" />
        </div>

        <div class="mb-4">
            <label class="block text-sm text-gray-400 mb-1">Title</label>
            <InputText @bind-Value="_model.Title"
                       class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100
                              focus:outline-none focus:border-cyan-500 text-sm"
                       placeholder="Concise active-voice title" />
        </div>

        <div class="mb-6">
            <label class="block text-sm text-gray-400 mb-1">Description</label>
            <InputTextArea @bind-Value="_model.Description" rows="6"
                           class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-gray-100
                                  focus:outline-none focus:border-cyan-500 text-sm resize-none"
                           placeholder="Include acceptance criteria and technical context…" />
        </div>

        <div class="flex gap-3">
            <button type="submit" disabled="@_isSubmitting"
                    class="px-5 py-2 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 text-white
                           text-sm rounded transition-colors">
                @(_isSubmitting ? "Starting…" : "Start Pipeline")
            </button>
            <a href="/" class="px-5 py-2 text-sm text-gray-400 hover:text-gray-200 transition-colors">
                Cancel
            </a>
        </div>
    </EditForm>
</div>

@code {
    private readonly TicketFormModel _model = new()
    {
        TicketId = $"INC{Random.Shared.Next(1000000, 9999999)}",
    };

    private bool _isSubmitting;

    private async Task HandleSubmitAsync()
    {
        _isSubmitting = true;
        StateHasChanged();

        var ticket = new TicketState
        {
            TicketId = _model.TicketId.Trim(),
            Title = _model.Title.Trim(),
            Description = _model.Description.Trim(),
        };

        var runId = Orchestrator.StartRun(ticket);
        await Task.Delay(100); // let the background task start before navigating
        Nav.NavigateTo($"/run/{runId}");
    }

    private sealed class TicketFormModel
    {
        public string TicketId { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
