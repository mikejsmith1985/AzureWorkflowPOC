@* Connector configuration administration page — simple labeled fields per connector type (FR-05, US5). *@
@page "/settings/connectors"
@inject IConnectorConfigRepository ConfigRepository
@inject IConnectorHealthChecker HealthChecker
@inject IAdoTelemetryPreflightService AdoPreflightService
@inject DBAIAzure.Web.Integrations.LLM.ILlmModelFetcherService LlmModelFetcher
@inject ILogger<ConnectorSettings> Logger
@inject NavigationManager Nav
@using DBAIAzure.Core.Interfaces
@using DBAIAzure.Core.Models
@using DBAIAzure.Core.Models.AdoTelemetry
@using DBAIAzure.Web.Components.Settings
@using System.Text.Json

<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-fg">Connector Settings</h1>
    <span class="text-sm text-muted">Configure credentials for each integration</span>
</div>

@if (_loading)
{
    <div class="text-muted text-sm">Loading…</div>
}
else
{
    <div class="space-y-4">
        @foreach (var entry in _entries)
        {
            <div class="rounded bg-surface border border-line p-5">
                <!-- ── Header ──────────────────────────────────────────────── -->
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <span class="text-sm font-semibold text-fg">@ConnectorDisplayName(entry.ConnectorType)</span>
                        @if (entry.ConnectorType == ConnectorType.Messaging && entry.PlatformLabel is { Length: > 0 } platform)
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full bg-raised text-fg">@platform</span>
                        }
                        @if (entry.IsConfigured)
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full bg-accent-subtle text-accent">Configured</span>
                        }
                        else
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full bg-warn-subtle text-warn">Not configured</span>
                        }
                        @if (entry.TestResult is not null)
                        {
                            var badgeClass = entry.TestResult.IsSuccess
                                ? "bg-ok-subtle text-ok" : "bg-err-subtle text-err";
                            <span class="text-xs px-2 py-0.5 rounded-full @badgeClass">
                                @(entry.TestResult.IsSuccess ? "Healthy" : "Unhealthy")
                            </span>
                        }
                    </div>
                    <div class="flex gap-2">
                        <button @onclick="() => ToggleEdit(entry)"
                                class="px-3 py-1.5 text-xs rounded bg-raised hover:bg-surface text-fg transition-colors">
                            @(entry.IsEditing ? "Cancel" : "Edit")
                        </button>
                        <button @onclick="() => RunHealthCheck(entry)"
                                disabled="@(!entry.IsConfigured || entry.IsChecking)"
                                class="px-3 py-1.5 text-xs rounded bg-accent hover:opacity-90 disabled:opacity-40
                                       disabled:cursor-not-allowed text-onaccent transition-colors">
                            @(entry.IsChecking ? "Checking…" : "Check Health")
                        </button>
                        @if (entry.ConnectorType == ConnectorType.WorkTracker && entry.StoredProvider == ProviderAzureDevOps)
                        {
                            <button @onclick="RunAdoPreflight"
                                    disabled="@(!entry.IsConfigured || _isPreflightRunning)"
                                    data-testid="ado-preflight-button"
                                    class="px-3 py-1.5 text-xs rounded bg-accent hover:opacity-90 disabled:opacity-40
                                           disabled:cursor-not-allowed text-onaccent transition-colors">
                                @(_isPreflightRunning ? "Running…" : "Test Connection")
                            </button>
                        }
                    </div>
                </div>

                <!-- ── Last health-check message ──────────────────────────── -->
                @if (entry.TestResult is { Message: { Length: > 0 } msg })
                {
                    <p class="text-xs text-muted mb-3">@msg · @FormatAge(entry.TestResult.TestedAt)</p>
                }

                <!-- ── ADO preflight result badge ─────────────────────────── -->
                @if (entry.ConnectorType == ConnectorType.WorkTracker && entry.StoredProvider == ProviderAzureDevOps && _preflightResult is not null)
                {
                    var preflightBadge = _preflightResult.IsSuccess
                        ? "bg-ok-subtle text-ok" : "bg-err-subtle text-err";
                    <div class="flex items-center gap-2 mb-3">
                        <span data-testid="ado-preflight-result"
                              class="text-xs px-2 py-0.5 rounded-full @preflightBadge">
                            @(_preflightResult.IsSuccess
                                ? $"Preflight OK — {_preflightResult.Manifest?.Mode}"
                                : $"Preflight failed: {_preflightResult.ErrorMessage}")
                        </span>
                    </div>
                }

                <!-- ── Edit form ──────────────────────────────────────────── -->
                @if (entry.IsEditing)
                {
                    <div class="mt-3 space-y-3 border-t border-line pt-3">

                        @if (entry.ConnectorType == ConnectorType.WorkTracker)
                        {
                            <!-- Provider selector — switching provider clears the prior health result. -->
                            <div>
                                <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Provider
                                    <InfoTip Content="Which work-tracking system this connector targets. The pipeline creates and updates work items in the selected provider." /></label>
                                <select @bind="entry.DraftProvider" @bind:after="() => { entry.TestResult = null; }"
                                        data-testid="worktracker-provider" class="@InputClass">
                                    <option value="">— select a provider —</option>
                                    <option value="@ProviderAzureDevOps">Azure DevOps</option>
                                    <option value="@ProviderJira">Jira</option>
                                </select>
                            </div>

                            @if (entry.DraftProvider == ProviderAzureDevOps)
                            {
                                <div>
                                    <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Organization URL
                                        <InfoTip Content="The web address of your Azure DevOps organization." Example="https://dev.azure.com/your-org" /></label>
                                    <input type="url" @bind="entry.DraftUrl" placeholder="https://dev.azure.com/your-org" class="@InputClass" />
                                </div>
                                <div>
                                    <label class="block text-xs text-muted mb-1">Project Name</label>
                                    <input type="text" @bind="entry.DraftUsername" placeholder="MyProject" class="@InputClass" />
                                </div>
                                <div>
                                    <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Personal Access Token
                                        <InfoTip Content="Authorizes work-item access. In Azure DevOps → User settings → Personal access tokens, create one with Work Items (read & write). Stored encrypted; leave blank to keep the existing one." /></label>
                                    <input type="password" @bind="entry.DraftSecret" placeholder="Leave blank to keep existing"
                                           autocomplete="new-password" class="@InputClass" />
                                </div>
                            }
                            else if (entry.DraftProvider == ProviderJira)
                            {
                                <div>
                                    <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Site URL
                                        <InfoTip Content="Your Jira Cloud site base URL." Example="https://your-org.atlassian.net" /></label>
                                    <input type="url" @bind="entry.DraftUrl" placeholder="https://your-org.atlassian.net" class="@InputClass" />
                                </div>
                                <div>
                                    <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Account Email
                                        <InfoTip Content="The Atlassian account email that owns the API token — used with the token for authentication." /></label>
                                    <input type="email" @bind="entry.DraftEmail" placeholder="you@your-org.com" class="@InputClass" />
                                </div>
                                <div>
                                    <label class="block text-xs text-muted mb-1">Project Key</label>
                                    <input type="text" @bind="entry.DraftProjectKey" placeholder="PROJ" class="@InputClass" />
                                </div>
                                <div>
                                    <label class="text-xs text-muted mb-1 flex items-center gap-1.5">API Token
                                        <InfoTip Content="A Jira Cloud API token (id.atlassian.com → Security → API tokens). Stored encrypted; leave blank to keep the existing one." /></label>
                                    <input type="password" @bind="entry.DraftSecret" placeholder="Leave blank to keep existing"
                                           autocomplete="new-password" class="@InputClass" />
                                </div>
                            }
                            else
                            {
                                <p class="text-xs text-muted" data-testid="worktracker-empty-state">
                                    Select a provider above to enter its connection details.
                                </p>
                            }
                        }
                        else if (entry.ConnectorType == ConnectorType.LLM)
                        {
                            <!-- Provider dropdown -->
                            <div>
                                <label class="block text-xs text-muted mb-1">Provider</label>
                                <select @bind="entry.DraftUrl" class="@InputClass">
                                    <option value="">— select provider —</option>
                                    <option value="anthropic">Anthropic (Claude)</option>
                                    <option value="openai">OpenAI</option>
                                </select>
                            </div>

                            <!-- API key -->
                            <div>
                                <label class="text-xs text-muted mb-1 flex items-center gap-1.5">API Key
                                    <InfoTip Content="Your provider API key (e.g. Anthropic or OpenAI). It's stored encrypted and never displayed again after saving — leave blank to keep the existing one." /></label>
                                <input type="password" @bind="entry.DraftSecret"
                                       placeholder="Leave blank to keep existing"
                                       autocomplete="new-password" class="@InputClass" />
                            </div>

                            <!-- Model — live dropdown loaded on demand -->
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label class="text-xs text-muted">Model</label>
                                    <button type="button"
                                            @onclick="() => FetchLlmModelsAsync(entry)"
                                            disabled="@(string.IsNullOrEmpty(entry.DraftUrl) || entry.IsFetchingModels)"
                                            class="text-xs px-2 py-0.5 rounded bg-raised hover:bg-surface
                                                   text-fg disabled:opacity-40 transition-colors">
                                        @(entry.IsFetchingModels ? "Loading…" : "Fetch Models")
                                    </button>
                                </div>
                                @if (entry.ModelFetchError is not null)
                                {
                                    <p class="text-xs text-err mb-1">@entry.ModelFetchError</p>
                                }
                                @if (entry.AvailableModels.Count > 0)
                                {
                                    <select @bind="entry.DraftUsername" class="@InputClass">
                                        @foreach (var model in entry.AvailableModels)
                                        {
                                            <option value="@model">@model</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" @bind="entry.DraftUsername"
                                           placeholder="Select provider and click Fetch Models"
                                           class="@InputClass" />
                                }
                            </div>
                        }
                        else if (entry.ConnectorType == ConnectorType.ServiceNow)
                        {
                            <div>
                                <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Instance URL
                                    <InfoTip Content="The base address of your ServiceNow instance." Example="https://acme.service-now.com" /></label>
                                <input type="url" @bind="entry.DraftUrl"
                                       placeholder="https://acme.service-now.com"
                                       class="@InputClass" />
                            </div>
                            <div>
                                <label class="block text-xs text-muted mb-1">Username</label>
                                <input type="text" @bind="entry.DraftUsername"
                                       placeholder="svc-account"
                                       class="@InputClass" />
                            </div>
                            <div>
                                <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Password
                                    <InfoTip Content="Password for the ServiceNow integration user. Stored encrypted; leave blank to keep the existing one." /></label>
                                <input type="password" @bind="entry.DraftSecret"
                                       placeholder="Leave blank to keep existing"
                                       autocomplete="new-password" class="@InputClass" />
                            </div>
                        }
                        else if (entry.ConnectorType == ConnectorType.Messaging)
                        {
                            <!-- Platform dropdown -->
                            <div>
                                <label class="block text-xs text-muted mb-1">Platform</label>
                                @* Switching platform invalidates the prior health result for the old platform. *@
                                <select @bind="entry.DraftUrl" @bind:after="() => { entry.TestResult = null; }" class="@InputClass">
                                    <option value="Teams">Microsoft Teams</option>
                                    <option value="Slack">Slack</option>
                                    <option value="Discord">Discord</option>
                                </select>
                            </div>

                            <p class="text-[11px] text-muted">
                                Delivery is MCP-first: if an MCP server is configured below it is used; otherwise the
                                platform's incoming webhook is used.
                            </p>

                            <!-- ── MCP server (preferred path) ─────────────────────────── -->
                            <div>
                                <label class="block text-xs text-muted mb-1">MCP Server URL <span class="text-muted">(optional)</span></label>
                                <input type="url" @bind="entry.DraftMcpServerUrl"
                                       placeholder="https://mcp.example.com/sse  (leave blank to use the webhook)"
                                       class="@InputClass" />
                            </div>
                            <div>
                                <label class="block text-xs text-muted mb-1">MCP Tool Name</label>
                                <input type="text" @bind="entry.DraftMcpToolName"
                                       placeholder="e.g. slack_post_message" class="@InputClass" />
                            </div>
                            <div>
                                <label class="block text-xs text-muted mb-1">Target (channel / recipient)</label>
                                <input type="text" @bind="entry.DraftTarget"
                                       placeholder="Channel id or recipient passed to the MCP tool" class="@InputClass" />
                            </div>
                            <div>
                                <label class="block text-xs text-muted mb-1">MCP Argument Template <span class="text-muted">(optional)</span></label>
                                <input type="text" @bind="entry.DraftMcpArgTemplate"
                                       placeholder='Blank uses a per-platform default (Slack: {"channel_id":"{{target}}","message":"{{message}}"})'
                                       class="@InputClass" />
                            </div>
                            <div>
                                <label class="block text-xs text-muted mb-1">MCP Auth Token <span class="text-muted">(optional)</span></label>
                                <input type="password" @bind="entry.DraftMcpAuthToken"
                                       placeholder="Bearer token for the MCP server (leave blank to keep existing)"
                                       autocomplete="new-password" class="@InputClass" />
                            </div>

                            <!-- ── Webhook fallback ─────────────────────────────────────── -->
                            <div>
                                <label class="text-xs text-muted mb-1 flex items-center gap-1.5">Webhook URL <span class="text-muted">(fallback)</span>
                                    <InfoTip Content="Incoming webhook URL for the selected platform — used when no MCP server is configured above." Example="https://hooks.slack.com/services/…" /></label>
                                <input type="password" @bind="entry.DraftSecret"
                                       placeholder="Incoming webhook URL for the selected platform (leave blank to keep existing)"
                                       autocomplete="new-password" class="@InputClass" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(entry.SaveError))
                        {
                            <p class="text-xs text-err">@entry.SaveError</p>
                        }

                        <div class="flex gap-2 pt-1">
                            <button @onclick="() => SaveEntry(entry)"
                                    disabled="@entry.IsSaving"
                                    class="px-4 py-1.5 text-xs rounded bg-accent hover:opacity-90
                                           disabled:opacity-40 text-onaccent transition-colors">
                                @(entry.IsSaving ? "Saving…" : "Save")
                            </button>
                            <button @onclick="() => ToggleEdit(entry)"
                                    class="px-3 py-1.5 text-xs rounded bg-raised hover:bg-surface
                                           text-fg transition-colors">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- DoR Validation Workflow (spec-021 US6): a dedicated card, rendered outside the connector loop
             because DorWorkflow is intentionally excluded from GetAllAsync. Purely additive. -->
        <DorWorkflowCard />
    </div>
}

@code {
    private const string InputClass =
        "w-full bg-raised border border-line rounded px-3 py-2 text-sm text-fg " +
        "placeholder-muted focus:outline-none focus:border-accent";

    private bool _loading = true;
    private List<ConnectorEntry> _entries = [];
    private bool _isPreflightRunning;
    private PreflightResult? _preflightResult;

    protected override async Task OnInitializedAsync()
    {
        var configs = await ConfigRepository.GetAllAsync();
        _entries = configs
            .OrderBy(c => c.Type.ToString())
            .Select(c => new ConnectorEntry(c))
            .ToList();
        _loading = false;
        ExpandFromQuery();
    }

    /// <summary>
    /// Honors a <c>?expand=&lt;ConnectorType&gt;</c> query parameter (the onboarding banner's deep-links)
    /// by opening that connector's edit form on load so the user lands directly on the right field.
    /// </summary>
    private void ExpandFromQuery()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (!query.TryGetValue("expand", out var requested)) return;

        var match = _entries.FirstOrDefault(
            e => string.Equals(e.ConnectorType.ToString(), requested, StringComparison.OrdinalIgnoreCase));
        if (match is { IsEditing: false })
            ToggleEdit(match);
    }

    private void ToggleEdit(ConnectorEntry entry)
    {
        entry.IsEditing = !entry.IsEditing;
        if (entry.IsEditing)
        {
            entry.LoadDraftFromJson();
            entry.DraftSecret       = string.Empty; // never pre-populate secrets (Article IX)
            entry.DraftMcpAuthToken = string.Empty; // (Messaging) MCP auth token is also a secret
            entry.SaveError         = string.Empty;

            // Auto-fetch models when opening LLM edit if a provider is already stored.
            if (entry.ConnectorType == ConnectorType.LLM && !string.IsNullOrEmpty(entry.DraftUrl))
                _ = InvokeAsync(async () => await FetchLlmModelsAsync(entry));
        }
    }

    private async Task FetchLlmModelsAsync(ConnectorEntry entry)
    {
        if (string.IsNullOrEmpty(entry.DraftUrl))
        {
            entry.ModelFetchError = "Select a provider first.";
            StateHasChanged();
            return;
        }

        // Use the draft key if the user has entered one; otherwise decrypt the stored key.
        var apiKey = entry.DraftSecret;
        if (string.IsNullOrEmpty(apiKey))
        {
            try
            {
                var stored = await ConfigRepository.GetDecryptedSecretsAsync(ConnectorType.LLM);
                if (stored is not null)
                {
                    using var doc = JsonDocument.Parse(stored);
                    if (doc.RootElement.TryGetProperty("apiKey", out var kp))
                        apiKey = kp.GetString() ?? string.Empty;
                }
            }
            catch { /* decryption failure — user must enter key manually */ }
        }

        if (string.IsNullOrEmpty(apiKey))
        {
            entry.ModelFetchError = "Enter an API key and click Fetch Models.";
            StateHasChanged();
            return;
        }

        entry.IsFetchingModels = true;
        entry.ModelFetchError  = null;
        entry.AvailableModels  = [];
        StateHasChanged();

        try
        {
            var models = await LlmModelFetcher.FetchModelsAsync(entry.DraftUrl, apiKey);
            entry.AvailableModels = models.ToList();

            // Keep current model selection if it's still in the list; otherwise take the first.
            if (!entry.AvailableModels.Contains(entry.DraftUsername))
                entry.DraftUsername = entry.AvailableModels.FirstOrDefault() ?? string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "LLM model fetch failed for provider {Provider}", entry.DraftUrl);
            entry.ModelFetchError = $"Could not fetch models: {ex.Message}";
        }
        finally
        {
            entry.IsFetchingModels = false;
            StateHasChanged();
        }
    }

    private async Task SaveEntry(ConnectorEntry entry)
    {
        entry.IsSaving  = true;
        entry.SaveError = string.Empty;
        StateHasChanged();

        try
        {
            var (nonSecretJson, secretJson) = entry.SerializeToJson();

            // null secretJson leaves the existing encrypted blob intact (Article IX).
            await ConfigRepository.SaveAsync(entry.ConnectorType, nonSecretJson, secretJson);

            entry.IsConfigured    = true;
            entry.NonSecretConfig = nonSecretJson;
            entry.IsEditing       = false;
            // A save invalidates the prior test result (the repository resets it too, FR-017), so clear
            // the in-memory copy — otherwise a stale "Unhealthy" message lingers over the new credentials.
            entry.TestResult      = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save connector config for {Type}", entry.ConnectorType);
            entry.SaveError = $"Save failed: {ex.Message}";
        }
        finally
        {
            entry.IsSaving = false;
        }
    }

    private async Task RunAdoPreflight()
    {
        _isPreflightRunning = true;
        _preflightResult    = null;
        StateHasChanged();
        try
        {
            _preflightResult = await AdoPreflightService.RunPreflightAsync(null, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ADO preflight threw unexpectedly from UI");
            _preflightResult = PreflightResult.Fail($"Unexpected error: {ex.Message}");
        }
        finally
        {
            _isPreflightRunning = false;
        }
    }

    private async Task RunHealthCheck(ConnectorEntry entry)
    {
        entry.IsChecking = true;
        StateHasChanged();
        try
        {
            entry.TestResult = await HealthChecker.TestAsync(entry.ConnectorType);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Health check threw for {Type}", entry.ConnectorType);
        }
        finally
        {
            entry.IsChecking = false;
        }
    }

    private static string ConnectorDisplayName(ConnectorType type) => type switch
    {
        ConnectorType.WorkTracker => "Work Tracking System",
        ConnectorType.AzureDevOps => "Azure DevOps",
        ConnectorType.LLM         => "LLM Provider",
        ConnectorType.ServiceNow  => "ServiceNow",
        ConnectorType.Messaging   => "Messaging",
        _                         => type.ToString(),
    };

    // Provider names for the generic Work Tracking System connector (match each adapter's TrackerKey).
    private const string ProviderAzureDevOps = "AzureDevOps";
    private const string ProviderJira        = "Jira";

    private static string FormatAge(DateTimeOffset at)
    {
        var age = DateTimeOffset.UtcNow - at;
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours   < 1) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalDays    < 1) return $"{(int)age.TotalHours}h ago";
        return $"{(int)age.TotalDays}d ago";
    }

    /// <summary>
    /// Mutable view-model for one connector card. Exposes simple named draft fields;
    /// JSON serialization/deserialization is encapsulated here, invisible to the template.
    /// </summary>
    private sealed class ConnectorEntry
    {
        public ConnectorType        ConnectorType   { get; }
        public bool                 IsConfigured    { get; set; }
        public string?              NonSecretConfig { get; set; }
        public ConnectorTestResult? TestResult      { get; set; }

        // UI state
        public bool   IsEditing  { get; set; }
        public bool   IsSaving   { get; set; }
        public bool   IsChecking { get; set; }
        public string SaveError  { get; set; } = string.Empty;

        // Named draft fields — mapping varies by connector type:
        // DraftUrl      = Organization URL (ADO) | Provider id (LLM) | Instance URL (SN) | Platform (Messaging)
        // DraftUsername = Project Name (ADO)      | selected model (LLM) | Username (SN)  | unused (Messaging)
        // DraftSecret   = PAT (ADO)               | API Key (LLM)     | Password (SN)     | Webhook URL (Messaging)
        public string DraftUrl      { get; set; } = string.Empty;
        public string DraftUsername { get; set; } = string.Empty;
        public string DraftSecret   { get; set; } = string.Empty;

        // Work Tracking System (generic connector): provider selector + Jira-only fields.
        // DraftUrl doubles as Site URL when the provider is Jira; DraftUsername stays the ADO project.
        public string DraftProvider   { get; set; } = string.Empty;
        public string DraftEmail      { get; set; } = string.Empty;
        public string DraftProjectKey { get; set; } = string.Empty;

        // Messaging-only draft fields (MCP path). DraftMcpAuthToken is a secret.
        public string DraftMcpServerUrl  { get; set; } = string.Empty;
        public string DraftMcpToolName   { get; set; } = string.Empty;
        public string DraftMcpArgTemplate { get; set; } = string.Empty;
        public string DraftTarget        { get; set; } = string.Empty;
        public string DraftMcpAuthToken  { get; set; } = string.Empty;

        // LLM-only: live model list state
        public List<string> AvailableModels  { get; set; } = [];
        public bool         IsFetchingModels { get; set; }
        public string?      ModelFetchError  { get; set; }

        public ConnectorEntry(ConnectorConfig config)
        {
            ConnectorType   = config.Type;
            IsConfigured    = config.IsConfigured;
            NonSecretConfig = config.NonSecretConfig;
            TestResult      = config.LastTestResult;
        }

        /// <summary>The provider stored on the Work Tracking System connector ("AzureDevOps"/"Jira"), or
        /// empty when not a work-tracker connector or unconfigured. Drives provider-specific UI (e.g. the ADO
        /// preflight button) outside the edit form.</summary>
        public string StoredProvider
        {
            get
            {
                if (ConnectorType != ConnectorType.WorkTracker || string.IsNullOrWhiteSpace(NonSecretConfig))
                    return string.Empty;
                try
                {
                    using var doc = JsonDocument.Parse(NonSecretConfig);
                    return doc.RootElement.TryGetProperty("provider", out var p) ? p.GetString() ?? string.Empty : string.Empty;
                }
                catch { return string.Empty; }
            }
        }

        /// <summary>Friendly platform name for the Messaging connector, parsed from the stored config;
        /// empty when not a Messaging connector or no platform is stored.</summary>
        public string PlatformLabel
        {
            get
            {
                if (ConnectorType != ConnectorType.Messaging || string.IsNullOrWhiteSpace(NonSecretConfig))
                    return string.Empty;
                try
                {
                    using var doc = JsonDocument.Parse(NonSecretConfig);
                    if (doc.RootElement.TryGetProperty("platform", out var p) && p.GetString() is { Length: > 0 } value)
                        return value == nameof(MessagingPlatform.Teams) ? "Microsoft Teams" : value;
                }
                catch { /* malformed — no label */ }
                return string.Empty;
            }
        }

        /// <summary>Populates DraftUrl and DraftUsername from the stored NonSecretConfig JSON.</summary>
        public void LoadDraftFromJson()
        {
            DraftUrl = DraftUsername = string.Empty;
            DraftProvider = DraftEmail = DraftProjectKey = string.Empty;
            DraftMcpServerUrl = DraftMcpToolName = DraftMcpArgTemplate = DraftTarget = string.Empty;
            AvailableModels = [];

            // Messaging defaults to the Teams platform when no config is stored yet.
            if (ConnectorType == ConnectorType.Messaging)
                DraftUrl = nameof(MessagingPlatform.Teams);

            if (string.IsNullOrWhiteSpace(NonSecretConfig)) return;

            try
            {
                using var doc = JsonDocument.Parse(NonSecretConfig);
                var root = doc.RootElement;

                // Work Tracking System: the provider discriminator drives which fields are read.
                if (ConnectorType == ConnectorType.WorkTracker)
                {
                    DraftProvider = Str(root, "provider");
                    if (DraftProvider == ProviderJira)
                    {
                        DraftUrl        = Str(root, "siteUrl");
                        DraftEmail      = Str(root, "email");
                        DraftProjectKey = Str(root, "projectKey");
                    }
                    else
                    {
                        DraftUrl      = Str(root, "organizationUrl");
                        DraftUsername = Str(root, "projectName");
                    }
                    return;
                }

                (DraftUrl, DraftUsername) = ConnectorType switch
                {
                    ConnectorType.LLM         => (Str(root, "provider"),        Str(root, "modelName")),
                    ConnectorType.ServiceNow  => (Str(root, "instanceUrl"),     Str(root, "username")),
                    ConnectorType.Messaging   => (Str(root, "platform"),        string.Empty),
                    _                         => (string.Empty, string.Empty),
                };

                if (ConnectorType == ConnectorType.Messaging)
                {
                    if (string.IsNullOrEmpty(DraftUrl)) DraftUrl = nameof(MessagingPlatform.Teams);
                    DraftMcpServerUrl   = Str(root, "mcpServerUrl");
                    DraftMcpToolName    = Str(root, "mcpToolName");
                    DraftMcpArgTemplate = Str(root, "mcpArgumentTemplate");
                    DraftTarget         = Str(root, "target");
                }

                static string Str(JsonElement el, string key) =>
                    el.TryGetProperty(key, out var p) ? (p.GetString() ?? string.Empty) : string.Empty;
            }
            catch { /* malformed — start blank */ }
        }

        /// <summary>
        /// Returns the (nonSecretJson, secretJson) pair ready for <see cref="IConnectorConfigRepository.SaveAsync"/>.
        /// secretJson is null when DraftSecret is blank, which preserves the existing encrypted secret.
        /// </summary>
        public (string? nonSecretJson, string? secretJson) SerializeToJson()
        {
            var nonSecret = ConnectorType switch
            {
                // Work Tracking System: discriminated by provider — ADO fields or Jira fields.
                ConnectorType.WorkTracker => DraftProvider == ProviderJira
                    ? JsonSerializer.Serialize(new { provider = ProviderJira, siteUrl = DraftUrl, email = DraftEmail, projectKey = DraftProjectKey })
                    : JsonSerializer.Serialize(new { provider = ProviderAzureDevOps, organizationUrl = DraftUrl, projectName = DraftUsername }),
                ConnectorType.LLM =>
                    JsonSerializer.Serialize(new { provider = DraftUrl, modelName = DraftUsername }),
                ConnectorType.ServiceNow =>
                    JsonSerializer.Serialize(new { instanceUrl = DraftUrl, username = DraftUsername }),
                ConnectorType.Messaging =>
                    JsonSerializer.Serialize(new
                    {
                        platform            = DraftUrl,
                        mcpServerUrl        = NullIfBlank(DraftMcpServerUrl),
                        mcpToolName         = NullIfBlank(DraftMcpToolName),
                        mcpArgumentTemplate = NullIfBlank(DraftMcpArgTemplate),
                        target              = NullIfBlank(DraftTarget),
                    }),
                _ => null,
            };

            // Messaging carries two secrets (webhook URL + MCP auth token) in one blob; the others have one.
            string? secret = ConnectorType == ConnectorType.Messaging
                ? SerializeMessagingSecret()
                : string.IsNullOrWhiteSpace(DraftSecret) ? null : ConnectorType switch
                {
                    // Work Tracking System secret name depends on the selected provider.
                    ConnectorType.WorkTracker => DraftProvider == ProviderJira
                        ? JsonSerializer.Serialize(new { apiToken = DraftSecret })
                        : JsonSerializer.Serialize(new { personalAccessToken = DraftSecret }),
                    ConnectorType.LLM         => JsonSerializer.Serialize(new { apiKey = DraftSecret }),
                    ConnectorType.ServiceNow  => JsonSerializer.Serialize(new { password = DraftSecret }),
                    _                         => null,
                };

            return (nonSecret, secret);
        }

        // Returns null (preserve existing) only when BOTH messaging secrets are blank; otherwise writes the
        // blob with whichever secrets were entered. MCP and webhook are alternative paths, so operators
        // normally set just one.
        private string? SerializeMessagingSecret()
        {
            var hasWebhook = !string.IsNullOrWhiteSpace(DraftSecret);
            var hasToken   = !string.IsNullOrWhiteSpace(DraftMcpAuthToken);
            if (!hasWebhook && !hasToken) return null;

            return JsonSerializer.Serialize(new
            {
                webhookUrl   = hasWebhook ? DraftSecret : null,
                mcpAuthToken = hasToken ? DraftMcpAuthToken : null,
            });
        }

        private static string? NullIfBlank(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
    }
}
