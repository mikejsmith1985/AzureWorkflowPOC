@* Standalone pipeline topology page — full Mermaid graph with step reference table. *@
@page "/graph"
@inject IJSRuntime JSRuntime

<div class="flex items-center gap-3 mb-6">
    <a href="/" class="text-gray-500 hover:text-cyan-400 text-sm transition-colors">← Threads</a>
    <span class="text-gray-700">/</span>
    <span class="text-gray-300 text-sm">Pipeline Topology</span>
</div>

<div class="bg-gray-900 border border-gray-800 rounded-lg p-6 mb-6">
    <div class="text-xs text-gray-500 mb-4">
        IntakePipeline — SK Process Framework
        <span class="ml-2 text-gray-700">·</span>
        <a href="https://learn.microsoft.com/semantic-kernel/processes/overview"
           target="_blank"
           class="ml-2 text-cyan-700 hover:text-cyan-400">SK Docs</a>
    </div>
    <div id="pipeline-topology-full" class="text-center overflow-x-auto min-h-48"></div>
</div>

<!-- Step reference table -->
<div class="bg-gray-900 border border-gray-800 rounded-lg overflow-hidden">
    <div class="px-4 py-3 bg-gray-800 text-xs text-gray-400 font-medium">Step Reference</div>
    <table class="w-full text-sm">
        <thead class="bg-gray-850 text-gray-500 text-left">
            <tr>
                <th class="px-4 py-3">Step</th>
                <th class="px-4 py-3">Trigger</th>
                <th class="px-4 py-3">Output Events</th>
                <th class="px-4 py-3">Purpose</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-800 text-gray-300">
            <tr>
                <td class="px-4 py-3 font-mono text-gray-400">Intake</td>
                <td class="px-4 py-3 text-xs text-gray-500">TicketReceived</td>
                <td class="px-4 py-3 text-xs text-gray-500">IntakeComplete</td>
                <td class="px-4 py-3 text-xs">
                    Normalises ticket fields — trims whitespace, generates default ID if missing.
                </td>
            </tr>
            <tr>
                <td class="px-4 py-3 font-mono text-blue-400">Validation</td>
                <td class="px-4 py-3 text-xs text-gray-500">IntakeComplete / HumanResponded</td>
                <td class="px-4 py-3 text-xs text-gray-500">ReadyPath / NotReadyPath / Blocked</td>
                <td class="px-4 py-3 text-xs">
                    LLM evaluates ticket against Definition of Ready (DoR). Re-runs on each PO clarification round.
                </td>
            </tr>
            <tr>
                <td class="px-4 py-3 font-mono text-amber-400">GapAnalysis</td>
                <td class="px-4 py-3 text-xs text-gray-500">NotReadyPath</td>
                <td class="px-4 py-3 text-xs text-gray-500">QuestionsReady</td>
                <td class="px-4 py-3 text-xs">
                    LLM generates 2–3 targeted clarifying questions scoped to the specific gaps.
                </td>
            </tr>
            <tr>
                <td class="px-4 py-3 font-mono text-amber-300">HitlPause</td>
                <td class="px-4 py-3 text-xs text-gray-500">QuestionsReady</td>
                <td class="px-4 py-3 text-xs text-gray-500">AwaitHuman (external)</td>
                <td class="px-4 py-3 text-xs">
                    Emits AwaitHuman across the SK Process boundary via IExternalKernelProcessMessageChannel.
                    Equivalent to LangGraph interrupt(). Suspends until PO submits answers.
                </td>
            </tr>
            <tr>
                <td class="px-4 py-3 font-mono text-cyan-400">Estimation</td>
                <td class="px-4 py-3 text-xs text-gray-500">ReadyPath</td>
                <td class="px-4 py-3 text-xs text-gray-500">EstimationComplete</td>
                <td class="px-4 py-3 text-xs">
                    LLM assigns Fibonacci story points (1, 2, 3, 5, 8, 13, 21) with structured reasoning.
                </td>
            </tr>
            <tr>
                <td class="px-4 py-3 font-mono text-emerald-400">Action</td>
                <td class="px-4 py-3 text-xs text-gray-500">EstimationComplete</td>
                <td class="px-4 py-3 text-xs text-gray-500">— (terminal)</td>
                <td class="px-4 py-3 text-xs">
                    Creates a Jira or Azure DevOps issue via IActionConnector. Terminal step — pipeline completes.
                </td>
            </tr>
        </tbody>
    </table>
</div>

@code {
    // Full topology with color-coded nodes. Uses StringBuilder because Razor does not support C# 11 raw string literals.
    private static readonly string FullMermaidDefinition = BuildFullTopology();

    private static string BuildFullTopology()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("flowchart LR");
        sb.AppendLine("    SNow([SNow]) -->|TicketReceived| Intake");
        sb.AppendLine("    Manual([Manual]) -->|TicketReceived| Intake");
        sb.AppendLine("    Intake -->|IntakeComplete| Validation");
        sb.AppendLine("    Validation -->|ReadyPath| Estimation");
        sb.AppendLine("    Validation -->|NotReadyPath| GapAnalysis");
        sb.AppendLine("    Validation -->|Blocked| Blocked([Blocked])");
        sb.AppendLine("    GapAnalysis -->|QuestionsReady| HitlPause");
        sb.AppendLine("    HitlPause -->|AwaitHuman| PO([PO])");
        sb.AppendLine("    PO -->|HumanResponded| Validation");
        sb.AppendLine("    Estimation -->|EstimationComplete| Action");
        sb.AppendLine("    Action --> Done([Done])");
        sb.AppendLine("    style SNow fill:#164e63,stroke:#22d3ee,color:#cffafe");
        sb.AppendLine("    style Manual fill:#164e63,stroke:#22d3ee,color:#cffafe");
        sb.AppendLine("    style Validation fill:#1e3a5f,stroke:#3b82f6,color:#bfdbfe");
        sb.AppendLine("    style GapAnalysis fill:#451a03,stroke:#f59e0b,color:#fef3c7");
        sb.AppendLine("    style HitlPause fill:#451a03,stroke:#f59e0b,color:#fef3c7");
        sb.AppendLine("    style PO fill:#3b1f00,stroke:#f97316,color:#fed7aa");
        sb.AppendLine("    style Estimation fill:#0c4a6e,stroke:#0ea5e9,color:#bae6fd");
        sb.AppendLine("    style Action fill:#064e3b,stroke:#10b981,color:#d1fae5");
        sb.AppendLine("    style Done fill:#064e3b,stroke:#10b981,color:#d1fae5");
        sb.AppendLine("    style Blocked fill:#4c0519,stroke:#f43f5e,color:#ffe4e6");
        return sb.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("mermaidRender", "pipeline-topology-full", FullMermaidDefinition);
    }
}
