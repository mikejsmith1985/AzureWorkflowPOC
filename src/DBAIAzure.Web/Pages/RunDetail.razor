@page "/run/{RunId}"
@implements IDisposable
@inject PipelineOrchestrator Orchestrator
@inject NavigationManager Nav

@if (_run is null)
{
    <p class="text-gray-500 p-8">Run not found.</p>
}
else
{
    <div class="flex items-center gap-3 mb-6">
        <a href="/" class="text-gray-500 hover:text-cyan-400 text-sm transition-colors">← Dashboard</a>
        <span class="text-gray-700">/</span>
        <span class="font-mono text-cyan-400 text-sm">@RunId</span>
        <StatusBadge Status="@_run.Status" />
    </div>

    <!-- Ticket summary ────────────────────────────────────────── -->
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4 mb-6">
        <div class="text-xs text-gray-500 mb-1">@_run.InitialTicket.TicketId</div>
        <div class="font-semibold text-gray-100">@_run.InitialTicket.Title</div>
        <div class="text-sm text-gray-400 mt-1 whitespace-pre-wrap">@_run.InitialTicket.Description</div>
    </div>

    <!-- Event log ─────────────────────────────────────────────── -->
    <div class="mb-6">
        <h2 class="text-sm font-medium text-gray-400 mb-3">Pipeline Events</h2>
        <div class="bg-gray-900 border border-gray-800 rounded-lg overflow-y-auto max-h-96 divide-y divide-gray-800">
            @foreach (var evt in _run.Events)
            {
                <div class="px-4 py-2.5 flex items-start gap-3">
                    <span class="text-xs font-mono text-gray-600 mt-0.5 shrink-0">
                        @evt.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                    </span>
                    <span class="text-xs font-medium w-24 shrink-0 @StepColor(evt.StepName)">
                        @evt.StepName
                    </span>
                    <span class="text-sm @LevelColor(evt.Level)">@evt.Message</span>
                </div>
            }
            @if (!_run.Events.Any())
            {
                <div class="px-4 py-3 text-sm text-gray-600">Pipeline starting…</div>
            }
        </div>
    </div>

    <!-- HITL input panel ──────────────────────────────────────── -->
    @if (_run.Status == PipelineRunStatus.AwaitingHuman)
    {
        <div class="bg-amber-950 border border-amber-800 rounded-lg p-5 mb-6">
            <h2 class="text-amber-300 font-medium mb-3">⏸ Awaiting PO Input</h2>
            @if (_run.HitlQuestions.Any())
            {
                <p class="text-sm text-amber-200 mb-3">Please answer the following questions:</p>
                <ol class="list-decimal list-inside space-y-1 mb-4">
                    @foreach (var question in _run.HitlQuestions)
                    {
                        <li class="text-sm text-amber-100">@question</li>
                    }
                </ol>
            }
            <textarea @bind="_hitlAnswer" rows="4"
                      class="w-full bg-gray-900 border border-amber-700 rounded px-3 py-2 text-gray-100
                             focus:outline-none focus:border-amber-400 text-sm resize-none mb-3"
                      placeholder="Type your answers here…"></textarea>
            <button @onclick="SubmitHitlAnswerAsync" disabled="@_isSubmittingHitl"
                    class="px-4 py-2 bg-amber-600 hover:bg-amber-500 disabled:opacity-50 text-white
                           text-sm rounded transition-colors">
                @(_isSubmittingHitl ? "Submitting…" : "Submit Answer")
            </button>
        </div>
    }

    <!-- Final result ──────────────────────────────────────────── -->
    @if (_run.Status == PipelineRunStatus.Complete && _run.CurrentTicket is { } final)
    {
        <div class="bg-emerald-950 border border-emerald-800 rounded-lg p-5">
            <h2 class="text-emerald-300 font-medium mb-3">✓ Complete</h2>
            <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
                <dt class="text-gray-500">Story Points</dt>
                <dd class="text-emerald-300 font-bold">@final.StoryPoints</dd>
                <dt class="text-gray-500">Reasoning</dt>
                <dd class="text-gray-200">@final.EstimationReasoning</dd>
                <dt class="text-gray-500">Jira</dt>
                <dd>
                    @if (final.JiraIssueUrl is not null)
                    {
                        <a href="@final.JiraIssueUrl" target="_blank"
                           class="text-cyan-400 hover:underline break-all">
                            @final.JiraIssueUrl
                        </a>
                    }
                </dd>
            </dl>
        </div>
    }

    @if (_run.Status == PipelineRunStatus.Blocked)
    {
        <div class="bg-rose-950 border border-rose-800 rounded-lg p-5">
            <h2 class="text-rose-300 font-medium">✗ Blocked</h2>
            <p class="text-sm text-rose-200 mt-1">
                Maximum clarification rounds reached. The ticket needs manual review.
            </p>
        </div>
    }

    @if (_run.Status == PipelineRunStatus.Failed)
    {
        <div class="bg-red-950 border border-red-800 rounded-lg p-5">
            <h2 class="text-red-300 font-medium">Pipeline Error</h2>
            <p class="text-sm text-red-200 font-mono mt-1">@_run.ErrorMessage</p>
        </div>
    }
}

@code {
    [Parameter] public string RunId { get; set; } = string.Empty;

    private PipelineRun? _run;
    private string _hitlAnswer = string.Empty;
    private bool _isSubmittingHitl;

    protected override void OnInitialized()
    {
        _run = Orchestrator.GetRun(RunId);
        Orchestrator.RunUpdated += OnRunUpdated;
    }

    private void OnRunUpdated(string updatedRunId)
    {
        if (updatedRunId == RunId)
            InvokeAsync(StateHasChanged);
    }

    private async Task SubmitHitlAnswerAsync()
    {
        if (string.IsNullOrWhiteSpace(_hitlAnswer)) return;
        _isSubmittingHitl = true;
        var answer = _hitlAnswer;
        _hitlAnswer = string.Empty;
        Orchestrator.SubmitHitlAnswer(RunId, answer);
        await Task.Delay(50);
        _isSubmittingHitl = false;
    }

    private static string StepColor(string stepName) => stepName switch
    {
        "Intake"      => "text-gray-400",
        "Validation"  => "text-blue-400",
        "GapAnalysis" => "text-amber-400",
        "HitlPause"   => "text-amber-300",
        "HitlResume"  => "text-cyan-400",
        "Estimation"  => "text-cyan-400",
        "Action"      => "text-emerald-400",
        _             => "text-gray-500",
    };

    private static string LevelColor(ReportLevel level) => level switch
    {
        ReportLevel.Success => "text-emerald-400",
        ReportLevel.Warning => "text-amber-400",
        ReportLevel.Error   => "text-rose-400",
        _                   => "text-gray-300",
    };

    public void Dispose() => Orchestrator.RunUpdated -= OnRunUpdated;
}
